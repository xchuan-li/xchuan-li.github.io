---
import Base from "../layouts/Base.astro";
import { projects } from "../data/projects";

// CV (A3g §10): conventional and scannable. It verifies the story told elsewhere;
// it does not retell it. Order: contact → research interests → education →
// manuscripts & projects → collaborations → methods & skills → languages.
// NOTE: /cv.pdf is a separately generated file; regenerate it (print this page) so
// the two do not contradict.
---

<Base
  title="CV · Xiaochuan Li"
  description="CV of Xiaochuan Li, M.Sc. Human and AI, University of Technology Nuremberg. Formal and experimental semantics, psycholinguistics, computational semantics, and language-model research."
>
  <header class="mb-8">
    <div class="flex items-baseline justify-between gap-4">
      <h1 class="text-3xl font-medium tracking-tight">Xiaochuan Li</h1>
      <a href="/cv.pdf" class="no-print text-sm text-[var(--color-accent)] hover:underline whitespace-nowrap">Download PDF ↗</a>
    </div>
    <p class="text-[var(--color-text-muted)] mt-1">M.Sc. Human and AI · University of Technology Nuremberg</p>
    <p class="text-sm text-[var(--color-text-dim)] mt-2">
      <a href="mailto:xiaochuan.li@utn.de" class="hover:text-[var(--color-accent)] transition-colors">xiaochuan.li@utn.de</a>
      · <a href="https://github.com/xchuan-li" class="hover:text-[var(--color-accent)] transition-colors">github.com/xchuan-li</a>
      · Nürnberg, Germany
    </p>
  </header>

  <section class="mb-8">
    <h2 class="text-[11px] uppercase tracking-wider text-[var(--color-text-dim)] font-medium mb-2">Research interests</h2>
    <p class="text-sm text-[var(--color-text-muted)] max-w-prose">
      Formal and experimental semantics; psycholinguistics; language processing and learning;
      computational semantics; language-model representation, evaluation, and intervention. Current
      focus: epistemic modality and discourse alternatives.
    </p>
  </section>

  <section class="mb-8">
    <h2 class="text-[11px] uppercase tracking-wider text-[var(--color-text-dim)] font-medium mb-3">Education</h2>
    <div class="space-y-3">
      <div class="flex justify-between gap-4 break-inside-avoid">
        <div>
          <p class="font-medium">M.Sc., Human and Artificial Intelligence</p>
          <p class="text-sm text-[var(--color-text-muted)]">University of Technology Nuremberg (UTN)</p>
          <p class="text-sm text-[var(--color-text-muted)] mt-0.5">Expected graduation: Summer 2027. Coursework: cognitive psychology, experimental design and statistics, interpretability, deep learning, epistemology.</p>
        </div>
        <p class="text-sm text-[var(--color-text-dim)] whitespace-nowrap">2025 – 2027</p>
      </div>
      <div class="flex justify-between gap-4 break-inside-avoid">
        <div>
          <p class="font-medium">Student · Preparatory Studies</p>
          <p class="text-sm text-[var(--color-text-muted)]">University of Marburg · enrolled student; intensive German for graduate study</p>
          <p class="text-sm text-[var(--color-text-muted)] mt-0.5">Comparing German with Chinese and English made grammatical differences—case, word order, and clause structure—concrete rather than abstract.</p>
        </div>
        <p class="text-sm text-[var(--color-text-dim)] whitespace-nowrap">2024 – 2025</p>
      </div>
      <div class="flex justify-between gap-4 break-inside-avoid">
        <div>
          <p class="font-medium">B.A., Philosophy</p>
          <p class="text-sm text-[var(--color-text-muted)]">Shenzhen University</p>
          <p class="text-sm text-[var(--color-text-muted)] mt-0.5">
            Senior thesis on Leibniz's <em>characteristica universalis</em> (advisor: Zang Yong). Coursework in philosophy of language, analytic philosophy, logic, and mathematical logic.
          </p>
        </div>
        <p class="text-sm text-[var(--color-text-dim)] whitespace-nowrap">2020 – 2024</p>
      </div>
    </div>
  </section>

  <section class="mb-8">
    <h2 class="text-[11px] uppercase tracking-wider text-[var(--color-text-dim)] font-medium mb-3">Current research: modality</h2>
    <div class="space-y-3 text-sm">
      <div class="break-inside-avoid">
        <p><span class="font-medium">{projects.threeWays.title}</span> — analysis in development</p>
        <p class="text-[var(--color-text-muted)] mt-0.5">{projects.threeWays.summary}</p>
      </div>
      <div class="break-inside-avoid">
        <p><span class="font-medium">M.Sc. thesis: {projects.thesis.title}</span> — in planning</p>
        <p class="text-[var(--color-text-muted)] mt-0.5">Planned alongside an existing study of how preschool children reason about possibilities; design being agreed, no data yet.</p>
      </div>
      <div class="break-inside-avoid">
        <p><span class="font-medium">{projects.modalModels.title}</span> — in development</p>
        <p class="text-[var(--color-text-muted)] mt-0.5">Diagnostics on pretrained models; controlled training of small models is planned.</p>
      </div>
    </div>
  </section>

  <section class="mb-8">
    <h2 class="text-[11px] uppercase tracking-wider text-[var(--color-text-dim)] font-medium mb-3">Papers and manuscripts</h2>
    <div class="space-y-4 text-sm">
      <div class="break-inside-avoid">
        <p><span class="font-medium">Typicality in referent choice: what the description leaves open</span> — working paper</p>
        <p class="text-[var(--color-text-muted)] mt-0.5">Superordinate descriptions, typicality, and what forced-choice responses can show.
          <a href="https://lingbuzz.net/lingbuzz/010343" class="text-[var(--color-accent)]">LingBuzz</a> ·
          <a href="https://doi.org/10.5281/zenodo.22855036" class="text-[var(--color-accent)]">DOI</a></p>
      </div>
      <div class="break-inside-avoid">
        <p><span class="font-medium">Prompt framing and latent control states</span> — {projects.latentControl.status.toLowerCase()}</p>
        <p class="text-[var(--color-text-muted)] mt-0.5">Designed controlled dilemma comparisons; experimental analysis of residual-stream interventions, low-rank effects, and competing explanations. Ongoing collaboration with DFKI.</p>
      </div>
    </div>
  </section>

  <section class="mb-8">
    <h2 class="text-[11px] uppercase tracking-wider text-[var(--color-text-dim)] font-medium mb-3">Course and technical projects</h2>
    <div class="space-y-4 text-sm">
      <div class="break-inside-avoid">
        <p><span class="font-medium">{projects.protobias.title}</span> — single-author course project</p>
        <p class="text-[var(--color-text-muted)] mt-0.5">Controlled evaluation across seven languages and two VLM families; approximately 12,600 judgments, item-clustered analysis, human controls, and pipeline-integrity checks.
          <a href={projects.protobias.href} class="text-[var(--color-accent)]">Report</a> ·
          <a href="https://github.com/xchuan-li/cross_lingual_protobias" class="text-[var(--color-accent)]">Code</a></p>
      </div>
      <div class="break-inside-avoid">
        <p><span class="font-medium">{projects.streetView.title}</span> — team course project</p>
        <p class="text-[var(--color-text-muted)] mt-0.5">Trained a CNN from random initialization and ran controlled experiments for 18-country classification. My contribution: training, ablations, and performance analysis; a teammate led the core implementation.</p>
      </div>
    </div>
  </section>

  <section class="mb-8">
    <h2 class="text-[11px] uppercase tracking-wider text-[var(--color-text-dim)] font-medium mb-3">Methods and technical skills</h2>
    <div class="space-y-2 text-sm">
      <div class="break-inside-avoid">
        <p><span class="font-medium">Programming and data.</span> <span class="text-[var(--color-text-muted)]">Python, NumPy, pandas, scikit-learn, Git, LaTeX.</span></p>
      </div>
      <div class="break-inside-avoid">
        <p><span class="font-medium">ML / NLP.</span> <span class="text-[var(--color-text-muted)]">PyTorch, Hugging Face Transformers, model inference, dataset pipelines, LoRA fine-tuning.</span></p>
      </div>
      <div class="break-inside-avoid">
        <p><span class="font-medium">Interpretability.</span> <span class="text-[var(--color-text-muted)]">Linear and structural probing, activation patching, steering, ablation (working proficiency).</span></p>
      </div>
      <div class="break-inside-avoid">
        <p><span class="font-medium">Experimental design and statistics.</span> <span class="text-[var(--color-text-muted)]">Controlled stimuli, minimal pairs, preregistration, mixed-effects analysis (working proficiency).</span></p>
      </div>
    </div>
  </section>

  <section class="mb-8">
    <h2 class="text-[11px] uppercase tracking-wider text-[var(--color-text-dim)] font-medium mb-3">Languages</h2>
    <p class="text-sm text-[var(--color-text-muted)]">Mandarin Chinese (native), German (C1), English (C1), Japanese (learning).</p>
  </section>
</Base>

<style is:global>
  /* /cv.pdf is printed from this page. Keep individual entries together on A4. */
  @media print {
    @page { size: A4; margin: 1.3cm 1.6cm; }
    html { font-size: 12.5px; }
    main header { margin-bottom: 1rem !important; }
    main section { margin-bottom: 0.7rem !important; }
    main h2 { margin-bottom: 0.45rem !important; }
    main .max-w-prose { max-width: none !important; }
  }
</style>
