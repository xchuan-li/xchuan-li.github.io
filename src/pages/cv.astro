---
import Base from "../layouts/Base.astro";

// CV (A3g §10): conventional and scannable. It verifies the story told elsewhere;
// it does not retell it. Order: contact → research interests → education →
// manuscripts & projects → collaborations → methods & skills → languages.
// NOTE: /cv.pdf is a separately generated file; regenerate it (print this page) so
// the two do not contradict.
---

<Base
  title="CV · Xiaochuan Li"
  description="CV of Xiaochuan Li, M.Sc. Human and AI, University of Technology Nuremberg. Experimental and computational semantics; epistemic modality; discourse update; language and reasoning; linguistically informed evaluation of language models."
>
  <header class="mb-8">
    <div class="flex items-baseline justify-between gap-4">
      <h1 class="text-3xl font-medium tracking-tight">Xiaochuan Li</h1>
      <a href="/cv.pdf" class="no-print text-sm text-[var(--color-accent)] hover:underline whitespace-nowrap">Download PDF ↗</a>
    </div>
    <p class="text-[var(--color-text-muted)] mt-1">M.Sc. Human and AI · University of Technology Nuremberg</p>
    <p class="text-sm text-[var(--color-text-dim)] mt-2">
      <a href="mailto:xiaochuan.li@utn.de" class="hover:text-[var(--color-accent)] transition-colors">xiaochuan.li@utn.de</a>
      · <a href="https://github.com/xchuan-li" class="hover:text-[var(--color-accent)] transition-colors">github.com/xchuan-li</a>
      · Nürnberg, Germany
    </p>
  </header>

  <section class="mb-8">
    <h2 class="text-[11px] uppercase tracking-wider text-[var(--color-text-dim)] font-medium mb-2">Research interests</h2>
    <p class="text-sm text-[var(--color-text-muted)] max-w-prose">
      Experimental and computational semantics; epistemic modality; discourse update; language and
      reasoning; linguistically informed evaluation of language models.
    </p>
  </section>

  <section class="mb-8">
    <h2 class="text-[11px] uppercase tracking-wider text-[var(--color-text-dim)] font-medium mb-3">Education</h2>
    <div class="space-y-3">
      <div class="flex justify-between gap-4 break-inside-avoid">
        <div>
          <p class="font-medium">M.Sc., Human and Artificial Intelligence</p>
          <p class="text-sm text-[var(--color-text-muted)]">University of Technology Nuremberg (UTN)</p>
          <p class="text-sm text-[var(--color-text-muted)] mt-0.5">Coursework: cognitive psychology, experimental design and statistics, interpretability, deep learning, epistemology.</p>
        </div>
        <p class="text-sm text-[var(--color-text-dim)] whitespace-nowrap">2025 – 2027</p>
      </div>
      <div class="flex justify-between gap-4 break-inside-avoid">
        <div>
          <p class="font-medium">German language program</p>
          <p class="text-sm text-[var(--color-text-muted)]">University of Marburg · intensive German for graduate study</p>
        </div>
        <p class="text-sm text-[var(--color-text-dim)] whitespace-nowrap">2024 – 2025</p>
      </div>
      <div class="flex justify-between gap-4 break-inside-avoid">
        <div>
          <p class="font-medium">B.A., Philosophy</p>
          <p class="text-sm text-[var(--color-text-muted)]">Shenzhen University</p>
          <p class="text-sm text-[var(--color-text-muted)] mt-0.5">
            Senior thesis on Leibniz's <em>characteristica universalis</em> (advisor: Zang Yong). Coursework in philosophy of language, analytic philosophy, logic, and mathematical logic.
          </p>
        </div>
        <p class="text-sm text-[var(--color-text-dim)] whitespace-nowrap">2020 – 2024</p>
      </div>
    </div>
  </section>

  <section class="mb-8">
    <h2 class="text-[11px] uppercase tracking-wider text-[var(--color-text-dim)] font-medium mb-3">Manuscripts and research projects</h2>
    <div class="space-y-4 text-sm">
      <div class="break-inside-avoid">
        <p><span class="font-medium">Epistemic modality and the maintenance of alternatives</span> <span class="text-[var(--color-text-dim)]">— manuscript in preparation</span></p>
        <p class="text-[var(--color-text-muted)] mt-0.5">Develops diagnostics for distinguishing content-specific alternative maintenance from mention, generic uncertainty, and perseveration. Construct brief under review by a formal semanticist.</p>
      </div>
      <div class="break-inside-avoid">
        <p><span class="font-medium">M.Sc. thesis: learnability of modal discourse effects</span> <span class="text-[var(--color-text-dim)]">— in design</span></p>
        <p class="text-[var(--color-text-muted)] mt-0.5">Tests whether a small language model can acquire the target distinctions from developmentally realistic linguistic input and which input patterns are necessary.</p>
      </div>
      <div class="break-inside-avoid">
        <p><span class="font-medium">Cross-Lingual Prototypicality Bias in Multimodal Evaluation Metrics and VLM Judges</span> <span class="text-[var(--color-text-dim)]">— first-author; in revision for arXiv</span></p>
        <p class="text-[var(--color-text-muted)] mt-0.5">Controlled cross-lingual evaluation across seven languages and two VLM families; about 12,600 judgments, item-clustered analysis, a human control, and public code.
          <a href="https://github.com/xchuan-li/cross_lingual_protobias" class="text-[var(--color-accent)] hover:underline whitespace-nowrap">GitHub ↗</a></p>
      </div>
    </div>
  </section>

  <section class="mb-8">
    <h2 class="text-[11px] uppercase tracking-wider text-[var(--color-text-dim)] font-medium mb-3">Research experience</h2>
    <div class="text-sm break-inside-avoid">
      <p><span class="font-medium">Latent Control States</span> <span class="text-[var(--color-text-dim)]">— ongoing collaboration with DFKI</span></p>
      <p class="text-[var(--color-text-muted)] mt-0.5">Designed a utilitarian minimal-pair experiment varying dilemma, benefit size, and framing to test whether prompt framing changes a causally relevant internal state.</p>
    </div>
  </section>

  <section class="mb-8">
    <h2 class="text-[11px] uppercase tracking-wider text-[var(--color-text-dim)] font-medium mb-3">Methods and technical skills</h2>
    <div class="space-y-2 text-sm">
      <div class="break-inside-avoid">
        <p><span class="font-medium">Programming and data.</span> <span class="text-[var(--color-text-muted)]">Python, NumPy, pandas, scikit-learn, Git, LaTeX.</span></p>
      </div>
      <div class="break-inside-avoid">
        <p><span class="font-medium">ML / NLP.</span> <span class="text-[var(--color-text-muted)]">PyTorch, Hugging Face Transformers, model inference, dataset pipelines, LoRA fine-tuning.</span></p>
      </div>
      <div class="break-inside-avoid">
        <p><span class="font-medium">Interpretability.</span> <span class="text-[var(--color-text-muted)]">Linear and structural probing, activation patching, steering, ablation (working proficiency).</span></p>
      </div>
      <div class="break-inside-avoid">
        <p><span class="font-medium">Experimental design and statistics.</span> <span class="text-[var(--color-text-muted)]">Controlled stimuli, minimal pairs, preregistration, mixed-effects analysis (working proficiency).</span></p>
      </div>
    </div>
  </section>

  <section class="mb-8">
    <h2 class="text-[11px] uppercase tracking-wider text-[var(--color-text-dim)] font-medium mb-3">Languages</h2>
    <p class="text-sm text-[var(--color-text-muted)]">Mandarin Chinese (native), German (C1), English (C1), Japanese (learning).</p>
  </section>
</Base>
