.project-cover{display:block;flex:0 0 105px}.project-cover img{width:105px;height:auto;display:block}
.project-note{margin-top:12px;padding-top:9px;border-top:1px solid var(--color-border);font-size:12px;line-height:1.5;color:var(--color-text-muted)}
.project-note span{display:block;color:var(--color-accent);margin-bottom:3px}
