---
import Base from "../layouts/Base.astro";
import { posts } from "../data/writing";
import { identityLong } from "../data/program";

// Homepage — a wider, modular "researcher personal site" (cf. karpathy.ai): a photo
// header, a reverse-chronological CV timeline (what I did, then its influence, with
// an institution logo per entry), the current projects, a personal "playground",
// and writing. The identity line comes from data/program.ts; the timeline, projects,
// and playground are page-specific and defined in this file.
//
// PHOTO: public/images/headshot.jpg — painted as a CSS background, so a missing file
// shows a clean empty frame, never a broken image.
//
// LOGOS: public/images/logos/{utn,marburg,szu}.svg, rendered in .tl-logo. Circular
// emblems (`emblem: true`) are sized up so they match the UTN wordmark's weight.

// The four current projects (B1–B4). Defined here on the homepage; the /research
// page keeps its own fuller records. Ordered mainline-first.
const projects = [
  {
    title: "Three Ways of Leaving p Unsettled",
    tag: "Formal semantics · in progress",
    href: "/research",
    current: true,
    desc: "A formal-semantics and pragmatics paper on three things everyday talk files under “uncertainty”: saying something might be so, saying it might or might not be, and saying you don’t know whether it is. Each leaves a different question open and licenses a different reply — the paper pins the distinction down. Currently under review by a formal semanticist.",
  },
  {
    title: "Master’s thesis — is meaning like this learnable?",
    tag: "Thesis · in design",
    href: "/research",
    desc: "Takes that distinction and asks a learnability question: trained on realistic input, does a small language model come to hold a possibility open and reason about it — and what in the input does that take? Formal analysis sets the target; a controlled corpus-and-training experiment tests it.",
  },
  {
    title: "Cross-lingual ProtoBias",
    tag: "First-author paper",
    href: "/research/cross-lingual-protobias",
    desc: "A first-author paper: a controlled cross-lingual audit — hold the image pair fixed, vary only the prompt language, and test whether vision-language judges track meaning or a culture-specific prototype. ~12,600 judgments across seven languages and two model families; public code, arXiv in preparation.",
  },
  {
    title: "Latent Control States",
    tag: "Collaboration · DFKI",
    href: "/research",
    desc: "With DFKI: does prompt framing shift a causally relevant latent state, or only the output? My part is a utilitarian minimal-pair probe — dilemma × benefit-size × framing — testing whether the model’s choice tracks the real stakes or just surface pressure.",
  },
];

const timeline = [
  {
    period: "2025 – present",
    mono: "UTN",
    logo: "/images/logos/utn.svg",
    org: "University of Technology Nuremberg (UTN)",
    role: "M.Sc. Human and Artificial Intelligence",
    did: "Coming from philosophy, I learned how language models work—and how to use them as experimental systems for studying linguistic knowledge. I now design controlled experiments that ask what models have learned about meaning, not simply how well they perform.",
    impact:
      "Here, my research question took its current form: how linguistic expressions structure information—which possibilities remain open, which are ruled out, and what can be taken up in later reasoning—and how that structure is acquired by people and learned by models. This is the thread connecting my work beyond any single thesis topic.",
  },
  {
    period: "2024 – 2025",
    mono: "UMR",
    logo: "/images/logos/marburg.svg",
    emblem: true,
    org: "University of Marburg",
    role: "German language program",
    did: "A year immersed in German became more than a language program: it was a close encounter with how grammar shapes meaning through case, word order, and clause structure.",
    impact:
      "Comparing German with Chinese and English taught me to see languages as systems of structural choices.",
  },
  {
    period: "2020 – 2024",
    mono: "SZU",
    logo: "/images/logos/szu.svg",
    emblem: true,
    org: "Shenzhen University",
    role: "B.A. Philosophy",
    did: "I studied philosophy of language, analytic philosophy, and logic, and wrote my senior thesis on Leibniz’s characteristica universalis—the idea of a universal notation whose form would mirror the structure of thought.",
    impact:
      "That project gave me the question that still anchors my work: if reasoning has a structure, how much of it is carried by the language through which we reason?",
  },
];

const recentPosts = posts.slice(0, 4);
---

<Base wide={true}>
  <div class="wrap">
    <!-- ===== header ===== -->
    <header class="hd">
      <div class="hd-main">
        <h1 class="hd-name">Xiaochuan Li</h1>
        <p class="hd-tag">{identityLong}</p>
        <p class="hd-affil">
          M.Sc. Human and AI · University of Technology Nuremberg · applying for PhD positions for fall 2027
        </p>
        <p class="hd-links">
          <a href="mailto:xiaochuan.li@utn.de">xiaochuan.li@utn.de</a>
          <span class="sep">·</span>
          <a href="/cv">CV</a>
          <span class="sep">·</span>
          <a href="https://github.com/xchuan-li" rel="noopener">GitHub</a>
          <span class="sep">·</span>
          <a href="https://www.linkedin.com/in/xiaochuan-li-0488533b5/" rel="noopener" target="_blank">LinkedIn</a>
        </p>
      </div>
      <div class="hd-photo" role="img" aria-label="Portrait of Xiaochuan Li"></div>
    </header>

    <!-- ===== timeline / CV ===== -->
    <section class="sec">
      <h2 class="sec-h">Timeline</h2>
      <div class="tl">
        {timeline.map((t) => (
          <div class="tl-item">
            <div class="tl-aside">
              <div class={`tl-logo${t.emblem ? " emblem" : ""}`}>
                {t.logo ? <img src={t.logo} alt={`${t.org} logo`} /> : <span aria-hidden="true">{t.mono}</span>}
              </div>
              <div class="tl-period">{t.period}</div>
            </div>
            <div class="tl-body">
              <h3 class="tl-org">{t.org}</h3>
              <p class="tl-role">{t.role}</p>
              <p class="tl-did">{t.did}</p>
              <p class="tl-impact">{t.impact}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ===== projects ===== -->
    <section class="sec">
      <h2 class="sec-h">Projects</h2>
      <div class="proj-list">
        {projects.map((p) => (
          <div class={`proj${p.current ? " proj-current" : ""}`}>
            <div class="proj-top">
              <a class="proj-title" href={p.href}>{p.title}</a>
              <span class="proj-tag">{p.tag}</span>
            </div>
            <p class="proj-desc">{p.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ===== playground ===== -->
    <section class="sec">
      <h2 class="sec-h">Playground</h2>
      <p class="block-note">Language isn’t only what I study — it’s what I tinker with. Two long-running side projects, for their own sake.</p>
      <div class="proj-list">
        <div class="proj">
          <div class="proj-top">
            <span class="proj-title-plain">Information Machines — a made-up language</span>
            <span class="proj-tag">Conlang · ongoing</span>
          </div>
          <p class="proj-desc">I’m building a small language as an experiment in how information can be introduced, connected, revised, and transmitted — the same thing I chase in research, here as pure play. It has a grammar, a changelog, and a test suite, and it is never finished.</p>
        </div>
        <div class="proj">
          <div class="proj-top">
            <span class="proj-title-plain">RELAY — a language-puzzle game</span>
            <span class="proj-tag">Game demo · prototype</span>
          </div>
          <p class="proj-desc">A puzzle game where you meet an invented language the way a field linguist would: watch a few scene-and-phrase pairs, work out the pieces and the order, then build a sentence you’ve never seen and test whether it transmits. A small authored thing, not a language-learning app.</p>
        </div>
      </div>
    </section>

    <!-- ===== writing ===== -->
    <section class="sec">
      <h2 class="sec-h">Writing</h2>
      <ul class="writing">
        {recentPosts.map((p) => (
          <li>
            <a href={`/writing/${p.slug}`}>{p.title}</a>
            <span class="writing-date">{p.date}{p.status === "draft" ? " · draft" : ""}</span>
          </li>
        ))}
      </ul>
      <p class="more"><a href="/writing">All writing →</a></p>
    </section>
  </div>
</Base>

<style>
  .wrap { max-width: 940px; margin: 0 auto; padding: 2.75rem 1.5rem 5rem; }

  /* ===== header ===== */
  .hd {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2.5rem;
    margin-bottom: 1rem;
  }
  .hd-photo {
    flex: none;
    width: 208px;
    height: 260px;
    border-radius: 14px;
    border: 1px solid var(--color-border);
    background-color: var(--color-surface-2);
    background-image: url("/images/headshot.jpg");
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }
  .hd-main { min-width: 0; }
  .hd-name {
    font-family: var(--font-display);
    font-size: 2.5rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin: 0 0 0.6rem;
    color: var(--color-text);
    line-height: 1.05;
  }
  .hd-tag {
    font-size: 1.15rem;
    line-height: 1.5;
    color: var(--color-text);
    margin: 0 0 0.9rem;
    max-width: 34rem;
  }
  .hd-affil {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin: 0 0 0.8rem;
    line-height: 1.5;
  }
  .hd-links { font-size: 0.9rem; color: var(--color-text-muted); margin: 0; }
  .hd-links a { color: var(--color-accent); text-decoration: none; }
  .hd-links a:hover { text-decoration: underline; }
  .hd-links .sep { color: var(--color-text-ghost); margin: 0 0.45rem; }

  @media (max-width: 620px) {
    .hd { flex-direction: column; align-items: flex-start; gap: 1.4rem; }
    .hd-photo { order: -1; width: 168px; height: 210px; }
    .hd-name { font-size: 2rem; }
    .hd-tag { font-size: 1.05rem; }
  }

  /* ===== section frame ===== */
  .sec { margin-top: 3.6rem; }
  .sec-h {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-text-dim);
    margin: 0 0 1.6rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--color-border);
  }

  /* ===== timeline ===== */
  .tl { display: flex; flex-direction: column; gap: 2rem; }
  .tl-item {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    gap: 1.75rem;
  }
  .tl-aside { display: flex; flex-direction: column; align-items: flex-start; gap: 0.6rem; }
  .tl-logo { min-height: 48px; display: flex; align-items: center; }
  .tl-logo img {
    height: 36px;
    width: auto;
    max-width: 124px;
    display: block;
  }
  /* circular emblems read smaller than a wordmark at the same height — size them up to match */
  .tl-logo.emblem img { height: 78px; }
  /* monogram fallback (only used if an entry has no logo file) */
  .tl-logo span {
    width: 52px;
    height: 52px;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    background: var(--color-surface-2);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.03em;
    color: var(--color-text-muted);
  }
  .tl-period {
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.03em;
    color: var(--color-text-dim);
  }
  .tl-org { font-size: 1.08rem; font-weight: 600; color: var(--color-text); margin: 0 0 0.15rem; letter-spacing: -0.005em; }
  .tl-role { font-size: 0.92rem; color: var(--color-text-muted); margin: 0 0 0.7rem; }
  .tl-did { font-size: 0.95rem; line-height: 1.65; color: var(--color-text-muted); margin: 0 0 0.6rem; }
  .tl-impact { font-size: 0.95rem; line-height: 1.65; color: var(--color-text-muted); margin: 0; }

  @media (max-width: 620px) {
    .tl-item { grid-template-columns: 1fr; gap: 0.9rem; }
    .tl-aside { flex-direction: row; align-items: center; gap: 0.9rem; }
  }

  /* ===== projects ===== */
  .proj-list { display: flex; flex-direction: column; }
  .proj { padding: 1.15rem 0; border-bottom: 1px solid var(--color-border); }
  .proj:first-child { border-top: 1px solid var(--color-border); }
  .proj-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 0.4rem;
  }
  .proj-title { font-size: 1.05rem; font-weight: 500; color: var(--color-text); text-decoration: none; }
  .proj-title:hover { color: var(--color-accent); }
  .proj-title-plain { font-size: 1.05rem; font-weight: 500; color: var(--color-text); }
  .proj-tag {
    flex: none;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-dim);
    white-space: nowrap;
  }
  .proj-current .proj-tag { color: var(--color-accent); }
  .proj-desc { font-size: 0.93rem; line-height: 1.65; color: var(--color-text-muted); margin: 0; max-width: 62ch; }

  /* ===== writing ===== */
  .writing { list-style: none; margin: 0; padding: 0; }
  .writing li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 0.72rem 0;
    border-bottom: 1px solid var(--color-border);
  }
  .writing li:first-child { border-top: 1px solid var(--color-border); }
  .writing a { color: var(--color-text); text-decoration: none; font-size: 0.98rem; }
  .writing a:hover { color: var(--color-accent); }
  .writing-date {
    flex: none;
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--color-text-dim);
    white-space: nowrap;
  }
  .more { margin: 1.1rem 0 0; font-size: 0.9rem; }
  .more a { color: var(--color-accent); text-decoration: none; }
  .more a:hover { text-decoration: underline; }
</style>
