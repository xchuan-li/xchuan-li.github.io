---
import Base from "../layouts/Base.astro";
import { projects } from "../data/research";
import { posts } from "../data/writing";
import { identityLong } from "../data/program";

// Homepage — a wider, modular academic page in the "researcher personal site"
// idiom (cf. karpathy.ai): a photo + one-line self-description header, a
// reverse-chronological CV timeline (what I did / what it gave me, with an
// institution logo per entry), then projects and writing. Positioning copy that
// states what the work IS comes from data/program.ts; project records from
// data/research.ts; the timeline (a CV, page-specific) is defined here.
//
// PHOTO: public/images/headshot.jpg — painted as a background, so a missing file
// shows a clean empty frame, never a broken image.
//
// LOGOS: each timeline entry shows a monogram tile as a placeholder. To use a real
// logo, drop a square-ish file at public/images/logos/<key>.png and, in the
// `.tl-logo` markup, replace the monogram text with
// `<img src="/images/logos/<key>.png" alt="" />` (there is a `.tl-logo img` rule
// ready for it). Keys: utn, marburg, szu, dfki.

const current = {
  title: "Epistemic modality & the maintenance of alternatives",
  tag: "M.Sc. thesis · construct stage",
  href: "/research",
  desc:
    "Does an epistemic possibility expression merely weaken a claim, or does it keep a content-specific alternative available for the reasoning that follows — and can that function be learned from linguistic input alone? The construct brief that fixes the target and its diagnostics is under review by a formal semanticist, before any model or behavioural study.",
};

const builtProjects = projects.filter((p) => !p.parked);

const timeline = [
  {
    period: "2025 – present",
    mono: "UTN",
    org: "University of Technology Nuremberg (UTN)",
    role: "M.Sc. Human and Artificial Intelligence",
    did: "Turned a philosophy question into a computational research programme — whether epistemic modal language keeps a possibility open for later reasoning, and whether that is learnable from language alone — and built the toolkit it runs on: controlled linguistic stimuli, model intervention and probing, mixed-effects analysis, with an ongoing interpretability collaboration at DFKI.",
    impact:
      "This is where a scattered set of interests became one research identity — experimental and computational semantics — and produced the projects below.",
  },
  {
    period: "2024 – 2025",
    mono: "UMR",
    org: "University of Marburg",
    role: "German language program · graduate preparation",
    did: "Reached C1 German over an intensive year — and, with Chinese and English already in hand, spent it living inside a third language rather than only studying one.",
    impact:
      "The real gain was comparative: holding Chinese, English, and German side by side, I could watch how each builds the same meaning by different means — context, word order, morphology — and read those contrasts from a non-native, philosophy-of-language angle. That cross-linguistic vantage point is now part of how I think about what a language actually encodes.",
  },
  {
    period: "2020 – 2024",
    mono: "SZU",
    org: "Shenzhen University",
    role: "B.A. Philosophy",
    did: "Logic, philosophy of language, and analytic philosophy; senior thesis on Leibniz's characteristica universalis.",
    impact:
      "It left me the question that still drives the work: can reasoning be formalized, and is there stable structure beneath natural language?",
  },
];

const recentPosts = posts.slice(0, 4);
---

<Base wide={true}>
  <div class="wrap">
    <!-- ===== header ===== -->
    <header class="hd">
      <div class="hd-photo" role="img" aria-label="Portrait of Xiaochuan Li"></div>
      <div class="hd-main">
        <h1 class="hd-name">Xiaochuan Li</h1>
        <p class="hd-tag">{identityLong}</p>
        <p class="hd-affil">
          M.Sc. Human and AI · University of Technology Nuremberg · applying for PhD positions for fall 2027
        </p>
        <p class="hd-links">
          <a href="mailto:xiaochuan.li@utn.de">xiaochuan.li@utn.de</a>
          <span class="sep">·</span>
          <a href="/cv">CV</a>
          <span class="sep">·</span>
          <a href="https://github.com/xchuan-li" rel="noopener">GitHub</a>
          <span class="sep">·</span>
          <a href="https://www.linkedin.com/in/xiaochuan-li-0488533b5/" rel="noopener" target="_blank">LinkedIn</a>
        </p>
      </div>
    </header>

    <!-- ===== timeline / CV ===== -->
    <section class="sec">
      <h2 class="sec-h">Timeline</h2>
      <div class="tl">
        {timeline.map((t) => (
          <div class="tl-item">
            <div class="tl-aside">
              <div class="tl-logo" aria-hidden="true">{t.mono}</div>
              <div class="tl-period">{t.period}</div>
            </div>
            <div class="tl-body">
              <h3 class="tl-org">{t.org}</h3>
              <p class="tl-role">{t.role}</p>
              <p class="tl-did">{t.did}</p>
              <p class="tl-impact">{t.impact}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ===== projects ===== -->
    <section class="sec">
      <h2 class="sec-h">Projects</h2>
      <div class="proj-list">
        <div class="proj proj-current">
          <div class="proj-top">
            <a class="proj-title" href={current.href}>{current.title}</a>
            <span class="proj-tag">{current.tag}</span>
          </div>
          <p class="proj-desc">{current.desc}</p>
        </div>
        {builtProjects.map((p) => (
          <div class="proj">
            <div class="proj-top">
              <a class="proj-title" href={p.href}>{p.title}</a>
              <span class="proj-tag">{p.output}</span>
            </div>
            <p class="proj-desc">{p.short ?? p.blurb}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ===== writing ===== -->
    <section class="sec">
      <h2 class="sec-h">Writing</h2>
      <ul class="writing">
        {recentPosts.map((p) => (
          <li>
            <a href={`/writing/${p.slug}`}>{p.title}</a>
            <span class="writing-date">{p.date}{p.status === "draft" ? " · draft" : ""}</span>
          </li>
        ))}
      </ul>
      <p class="more"><a href="/writing">All writing →</a></p>
    </section>
  </div>
</Base>

<style>
  .wrap { max-width: 940px; margin: 0 auto; padding: 2.75rem 1.5rem 5rem; }

  /* ===== header ===== */
  .hd {
    display: flex;
    align-items: center;
    gap: 2.25rem;
    margin-bottom: 1rem;
  }
  .hd-photo {
    flex: none;
    width: 200px;
    height: 200px;
    border-radius: 14px;
    border: 1px solid var(--color-border);
    background-color: var(--color-surface-2);
    background-image: url("/images/headshot.jpg");
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }
  .hd-main { min-width: 0; }
  .hd-name {
    font-family: var(--font-display);
    font-size: 2.5rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin: 0 0 0.6rem;
    color: var(--color-text);
    line-height: 1.05;
  }
  .hd-tag {
    font-size: 1.15rem;
    line-height: 1.5;
    color: var(--color-text);
    margin: 0 0 0.9rem;
    max-width: 34rem;
  }
  .hd-affil {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin: 0 0 0.8rem;
    line-height: 1.5;
  }
  .hd-links { font-size: 0.9rem; color: var(--color-text-muted); margin: 0; }
  .hd-links a { color: var(--color-accent); text-decoration: none; }
  .hd-links a:hover { text-decoration: underline; }
  .hd-links .sep { color: var(--color-text-ghost); margin: 0 0.45rem; }

  @media (max-width: 620px) {
    .hd { flex-direction: column; align-items: flex-start; gap: 1.4rem; }
    .hd-photo { width: 148px; height: 148px; }
    .hd-name { font-size: 2rem; }
    .hd-tag { font-size: 1.05rem; }
  }

  /* ===== section frame ===== */
  .sec { margin-top: 3.6rem; }
  .sec-h {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-text-dim);
    margin: 0 0 1.6rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--color-border);
  }

  /* ===== timeline ===== */
  .tl { display: flex; flex-direction: column; gap: 2rem; }
  .tl-item {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    gap: 1.75rem;
  }
  .tl-aside { display: flex; flex-direction: column; align-items: flex-start; gap: 0.6rem; }
  .tl-logo {
    width: 56px;
    height: 56px;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    background: var(--color-surface-2);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.03em;
    color: var(--color-text-muted);
    overflow: hidden;
  }
  .tl-logo img { width: 100%; height: 100%; object-fit: contain; display: block; }
  .tl-period {
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.03em;
    color: var(--color-text-dim);
  }
  .tl-org { font-size: 1.08rem; font-weight: 600; color: var(--color-text); margin: 0 0 0.15rem; letter-spacing: -0.005em; }
  .tl-role { font-size: 0.92rem; color: var(--color-text-muted); margin: 0 0 0.7rem; }
  .tl-did { font-size: 0.95rem; line-height: 1.65; color: var(--color-text-muted); margin: 0 0 0.6rem; }
  .tl-impact { font-size: 0.95rem; line-height: 1.65; color: var(--color-text-muted); margin: 0; }

  @media (max-width: 620px) {
    .tl-item { grid-template-columns: 1fr; gap: 0.9rem; }
    .tl-aside { flex-direction: row; align-items: center; gap: 0.9rem; }
  }

  /* ===== projects ===== */
  .proj-list { display: flex; flex-direction: column; }
  .proj { padding: 1.15rem 0; border-bottom: 1px solid var(--color-border); }
  .proj:first-child { border-top: 1px solid var(--color-border); }
  .proj-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 0.4rem;
  }
  .proj-title { font-size: 1.05rem; font-weight: 500; color: var(--color-text); text-decoration: none; }
  .proj-title:hover { color: var(--color-accent); }
  .proj-tag {
    flex: none;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-dim);
    white-space: nowrap;
  }
  .proj-current .proj-tag { color: var(--color-accent); }
  .proj-desc { font-size: 0.93rem; line-height: 1.65; color: var(--color-text-muted); margin: 0; max-width: 62ch; }

  /* ===== writing ===== */
  .writing { list-style: none; margin: 0; padding: 0; }
  .writing li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 0.72rem 0;
    border-bottom: 1px solid var(--color-border);
  }
  .writing li:first-child { border-top: 1px solid var(--color-border); }
  .writing a { color: var(--color-text); text-decoration: none; font-size: 0.98rem; }
  .writing a:hover { color: var(--color-accent); }
  .writing-date {
    flex: none;
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--color-text-dim);
    white-space: nowrap;
  }
  .more { margin: 1.1rem 0 0; font-size: 0.9rem; }
  .more a { color: var(--color-accent); text-decoration: none; }
  .more a:hover { text-decoration: underline; }
</style>
