---
import Base from "../layouts/Base.astro";
import { openingQuestions, programmeSummary } from "../data/program";
import { projects } from "../data/projects";

const latest = [
  {
    date: "September 2026",
    html: '<a href="/research/typicality-in-referent-choice">Typicality in referent choice: what the description leaves open</a>. Working paper, <a href="https://lingbuzz.net/lingbuzz/010343" rel="noopener">lingbuzz/010343</a>, <a href="https://doi.org/10.5281/zenodo.22855036" rel="noopener">doi:10.5281/zenodo.22855036</a>.',
  },
];

const timeline = [
  {
    period: "2020 – 2024",
    logo: "/images/logos/szu.svg",
    emblem: true,
    org: "Shenzhen University",
    role: "B.A. Philosophy",
    phase: "The formal question",
    did: "Philosophy of language, analytic philosophy, and logic — with a senior thesis on Leibniz’s <em>characteristica universalis</em>, a notation whose form was meant to mirror the structure of thought.",
    groups: [
      {
        questions: [
          "What is gained — and lost — when natural language is translated into logic?",
        ],
      },
    ],
  },
  {
    period: "2024 – 2025",
    logo: "/images/logos/marburg.svg",
    emblem: true,
    org: "University of Marburg",
    role: "Student · Preparatory Studies",
    phase: "Meaning across linguistic forms",
    did: "A year of preparatory studies as an enrolled student, learning German for graduate work — reading the same meanings through German, Chinese, and English.",
    groups: [
      {
        questions: [
          "Which parts of an interpretation are encoded, and which are supplied by context?",
        ],
      },
    ],
  },
  {
    period: "2025 – present",
    logo: "/images/logos/utn.svg",
    org: "University of Technology Nuremberg (UTN)",
    role: "M.Sc. Human and Artificial Intelligence",
    phase: "From formal questions to empirical methods",
    did: "Graduate training in cognitive psychology, experimental design and statistics, deep learning, and interpretability, connecting linguistic questions with evidence from human behaviour and computational models.",
    groups: [
      {
        questions: [
          "How can behavioural experiments distinguish competing accounts of meaning?",
        ],
      },
    ],
  },
];



---

<Base wide={true}>
<div class="wrap">
<header class="identity"><div class="identity-copy"><h1>Xiaochuan Li</h1><p class="affiliation">M.Sc. Human and AI · University of Technology Nuremberg</p><p class="research-fields">Semantics &amp; pragmatics · Human cognition · Language models</p><p class="contact-line"><a href="mailto:xiaochuan.li@utn.de">xiaochuan.li@utn.de</a><a href="/cv/">CV</a><a href="https://github.com/xchuan-li">GitHub</a><span>PhD applications · fall 2027</span></p></div><img class="portrait" src="/images/headshot.jpg" alt="Portrait of Xiaochuan Li" width="100" height="125" /></header>
<section class="opening" data-active="modal" aria-label="An example of my research questions">
<div class="passage">
<p class="scene">A linguistic illustration. Through binoculars, a speaker reports:</p>
<ol class="utterances">
<li>There <button class="word" type="button" data-key="modal" aria-pressed="true" aria-controls="note-content">might</button> be <button class="word" type="button" data-key="typicality" aria-pressed="false" aria-controls="note-content">an animal</button> perched on a branch.</li>
<li><button class="word" type="button" data-key="confirmation" aria-pressed="false" aria-controls="note-content">There is</button>. I can see it now.</li>
<li>It’s <button class="word" type="button" data-key="restriction" aria-pressed="false" aria-controls="note-content">above the green leaves.</button></li>
</ol>
<p class="hint"><span class="desktop-hint">Hover or focus the underlined words.</span><span class="mobile-hint">Tap an underlined phrase to read the note.</span></p>
</div>
<details class="notes" id="annotation" open>
<summary><span id="annotation-title">Epistemic modality</span><span class="note-tag" id="note-tag">Possible</span></summary>
<div id="note-content" aria-live="polite" aria-atomic="true">
<p class="note-copy" id="annotation-body">An animal on the branch is a possibility. The speaker has not yet asserted that it is there.</p>
<p class="update" id="update">What has the speaker committed to so far?</p>
<dl class="candidates" id="candidate-pair" hidden>
<div class="candidate" id="monkey"><dt>Monkey</dt><dd id="monkey-status">Red leaves · fits</dd></div>
<div class="candidate" id="insect"><dt>Stick insect</dt><dd id="insect-status">Green leaves · fits</dd></div>
</dl>
<p class="fine-print" id="scene-note">Illustrative example, not an experimental result.</p>
</div>
</details>
<noscript><p class="no-script-note">“Might” raises a possibility; “There is” asserts it. In the imagined scene, both a monkey and a stick insect fit “an animal perched on a branch”. Only the stick insect is above green leaves. Typicality is a possible preference, not an observed result here.</p></noscript>
</section>
<section class="research-intro" aria-labelledby="research-question">
<p class="section-label">Research programme · LCLM</p>
<h2 id="research-question">{openingQuestions}</h2>
<p>{programmeSummary}</p>
<div class="programme-loop" aria-label="Research programme: linguistic analysis guides studies of people and models; explanatory models and evidence inform revised linguistic accounts.">
<div class="programme-stage"><strong>Linguistic analysis</strong><span>Define contrasts and predictions</span></div>
<div class="programme-stage"><strong>Human evidence &amp; LM evaluation</strong><span>Test people and models; distinguish the conclusions</span></div>
<div class="programme-stage"><strong>Explanatory models</strong><span>A longer-term direction</span></div>
</div>
<div class="programme-return"><span>↶ Evidence and explanations refine the linguistic account</span><a href="/approach/">Full research programme →</a></div>
</section>
<section aria-labelledby="selected-work">
<h2 class="section-label" id="selected-work">Selected research · two connected questions</h2>
<section class="work-group" aria-labelledby="typicality-work">
<div class="group-heading"><h3 id="typicality-work">Typicality &amp; reference</h3><p>When do explicit descriptions outweigh typical expectations?</p></div>
<div class="work-pair">
<article class="work-card" data-project="B6"><p class="work-kind">Linguistic analysis · Semantics &amp; pragmatics</p><h4><a href={projects.typicality.href}>{projects.typicality.title}</a></h4><p class="work-copy">Separating candidate eligibility, typicality preferences and explicit restrictions in the interpretation of descriptions.</p><p class="status">{projects.typicality.status}</p></article>
<article class="work-card" data-project="B1"><p class="work-kind">Language-model study · VLM evaluation</p><h4><a href={projects.protobias.href}>{projects.protobias.title}</a></h4><div class="project-summary"><p class="work-copy">Testing whether vision–language models follow explicit semantic constraints across seven languages and two VLM systems.</p><a class="project-cover" href={projects.protobias.href} aria-label="View the Cross-lingual ProtoBias study"><img src="/images/project-covers/protobias.png" alt="Seven language prompts with a duck and panda image pair" width="1200" height="720" loading="lazy" /></a></div><p class="status">{projects.protobias.status}</p><aside class="project-note note-right"><span>Motive</span>A correct answer alone does not identify which information a model used. Competing explanations need controlled comparisons.</aside></article>
</div>
</section>
<section class="work-group" aria-labelledby="modality-work">
<div class="group-heading"><h3 id="modality-work">Epistemic modality</h3><p>What remains open after a possibility is expressed?</p></div>
<div class="work-pair">
<article class="work-card" data-project="B2"><p class="work-kind">Linguistic analysis · Semantics &amp; pragmatics</p><h4><a href={projects.threeWays.href}>{projects.threeWays.title}</a></h4><p class="work-copy">Distinguishing expressions that leave a question unresolved, and the different commitments and inferences they support.</p><p class="status">{projects.threeWays.status}</p></article>
<article class="work-card" data-project="B3"><p class="work-kind">Human behavioural study · Proposed</p><h4><a href={projects.thesis.href}>{projects.thesis.title}</a></h4><p class="work-copy">A proposed study of how people interpret epistemic expressions and use subsequent information to update their judgments.</p><p class="status">{projects.thesis.status}</p><aside class="project-note note-right"><span>Connection</span>The formal analysis identifies a contrast. A behavioural study could test what that contrast changes for a listener.</aside></article>
</div>
</section>
<article class="methods" data-project="B4"><div><p class="work-kind">Language-model study · Mechanistic interpretability</p><h3><a href={projects.latentControl.href}>{projects.latentControl.title}</a></h3></div><div><p class="work-copy">A DFKI collaboration investigating how internal model states relate to behaviour, through controlled contrasts and mechanistic tests.</p><p class="status">{projects.latentControl.status}</p></div></article>
<p class="more"><a href="/research">All current work →</a></p>
</section>
    <!-- ===== latest ===== -->
    <section class="sec" aria-labelledby="latest-heading">
      <h2 class="sec-h" id="latest-heading">Latest</h2>
      <ul class="latest-list">
        {latest.map((item) => (
          <li class="latest-item">
            <span class="latest-date">{item.date}</span>
            <span class="latest-text" set:html={item.html} />
          </li>
        ))}
      </ul>
    </section>

    <!-- ===== background ===== -->
    <section class="sec">
      <h2 class="sec-h">Background</h2>
      <div class="tl">
        {timeline.map((t) => (
          <div class="tl-item">
            <div class="tl-aside">
              <div class={`tl-logo${t.emblem ? " emblem" : ""}`}>
                <img src={t.logo} alt={`${t.org} logo`} />
              </div>
              <div class="tl-period">{t.period}</div>
            </div>
            <div class="tl-body">
              <h3 class="tl-org">{t.org}</h3>
              <p class="tl-role">{t.role}</p>
              <p class="tl-phase">{t.phase}</p>
              <p class="tl-did" set:html={t.did} />
              {t.groups.map((g) => (
                <div class="tl-group">
                  {g.label && <p class="tl-group-label">{g.label}</p>}
                  <ul class="tl-qs">
                    {g.questions.map((q) => <li set:html={q} />)}
                  </ul>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ===== contact ===== -->
    <section class="sec">
      <div class="cta">
        <p class="cta-line">Currently applying for PhD positions beginning in fall 2027 — email is the best way to get in touch.</p>
        <p class="cta-links">
          <a href="mailto:xiaochuan.li@utn.de">Email me</a>
          <span class="sep">·</span>
          <a href="/contact">More ways to get in touch</a>
        </p>
      </div>
    </section>

</div>
<script is:inline>
(()=>{
 const states={
 modal:{title:'Epistemic modality',tag:'Possible',body:'An animal on the branch is a possibility. The speaker has not yet asserted that it is there.',update:'What has the speaker committed to so far?',pair:false,note:'Illustrative example, not an experimental result.'},
 typicality:{title:'Typicality & reference',tag:'Both fit',body:'Does “animal” bring one candidate to mind more readily? Both fit the broad description.',update:'Consider two animals, both perched on branches:',pair:true,monkey:'Red leaves · fits',insect:'Green leaves · fits',note:'The typicality ordering here is illustrative.'},
 confirmation:{title:'Confirmation',tag:'Asserted',body:'The speaker now asserts that an animal is there. Its identity remains unresolved.',update:'Reference remains unresolved.',pair:true,monkey:'Red leaves · fits',insect:'Green leaves · fits',note:'These are two candidates in an imagined scene.'},
 restriction:{title:'Restricting information',tag:'One fits',body:'The added detail identifies the stick insect. The monkey does not fit.',update:'Both candidates are on branches.',pair:true,monkey:'Red leaves · does not fit',insect:'Green leaves · fits',note:'Reference changes; both animals remain.'}
 };
 const get=id=>document.getElementById(id),notes=get('annotation'),buttons=[...document.querySelectorAll('[data-key]')],small=matchMedia('(max-width:680px)');
 notes.open=!small.matches;
 function set(key){const s=states[key];if(!s)return;document.querySelector('.opening').dataset.active=key;buttons.forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.key===key)));get('annotation-title').textContent=s.title;get('note-tag').textContent=s.tag;get('annotation-body').textContent=s.body;get('update').textContent=s.update;get('scene-note').textContent=s.note;get('candidate-pair').hidden=!s.pair;get('candidate-pair').style.display=s.pair?'grid':'none';if(s.pair){get('monkey-status').textContent=s.monkey;get('insect-status').textContent=s.insect}get('monkey').classList.toggle('expected',key==='typicality');get('insect').classList.toggle('selected',key==='restriction');notes.open=true;}
 buttons.forEach(b=>{b.addEventListener('pointerenter',e=>{if(e.pointerType!=='touch')set(b.dataset.key)});b.addEventListener('focus',()=>set(b.dataset.key));b.addEventListener('click',()=>set(b.dataset.key));});
 small.addEventListener('change',e=>{notes.open=!e.matches});
 get('candidate-pair').style.display='none';
})();
</script>
</Base>
<style>a{color:inherit;text-underline-offset:4px;text-decoration-thickness:1px}a:hover{color:var(--color-accent)}
a:focus-visible,button:focus-visible,summary:focus-visible{outline:2px solid var(--color-accent);outline-offset:4px}
.identity{margin:0 0 20px}
h1{font:normal 33px/1.2 var(--font-serif);letter-spacing:-.65px;margin:0 0 6px}
.research-fields{font-size:14px;margin:9px 0 0;color:var(--color-text)}
.affiliation{color:var(--color-text-muted);font-size:13px;margin:0}
.contact-line{display:flex;flex-wrap:wrap;gap:7px 16px;font-size:12px;margin:9px 0 0;color:var(--color-text-muted)}
.opening{display:grid;grid-template-columns:minmax(0,1fr) 270px;gap:34px;padding:17px 0 16px;border-top:1px solid var(--color-border);border-bottom:1px solid var(--color-border)}
.scene{font:italic 14px/1.5 var(--font-serif);color:var(--color-text-muted);margin:0 0 9px}
.utterances{list-style:none;margin:0;padding:0;display:grid;gap:5px}
.utterances li{font:normal 21px/1.4 var(--font-serif);letter-spacing:-.25px;text-wrap:pretty}
.word{font:inherit;line-height:inherit;letter-spacing:inherit;appearance:none;display:inline;border:0;border-bottom:1px dotted #ad8173;color:inherit;background:transparent;padding:0;margin:0;cursor:pointer;text-align:left;-webkit-tap-highlight-color:transparent;user-select:none;transition:color 150ms,border-color 150ms}
.word[aria-pressed="true"],.word:hover{color:var(--color-accent);border-bottom:1px solid var(--color-accent)}
.hint{font-size:12px;color:var(--color-text-muted);margin:10px 0 0}.mobile-hint{display:none}
.notes{align-self:start;min-height:204px;padding-left:20px;border-left:1px solid var(--color-border);font-size:13px}
.notes summary{display:flex;align-items:baseline;gap:9px;list-style:none;cursor:pointer;font-size:13px;line-height:1.5;color:var(--color-accent)}
.notes summary::-webkit-details-marker{display:none}
.notes summary::after{content:'−';margin-left:auto;color:var(--color-text-muted);font-size:13px}
.notes:not([open]) summary::after{content:'+'}
.note-tag{font-size:12px;color:var(--color-text-muted);white-space:nowrap}
.note-copy{margin:8px 0 8px;font-size:14px;line-height:1.5;min-height:63px;text-wrap:pretty}
.update{font-size:12px;color:var(--color-text-muted);margin:0 0 7px;line-height:1.5}
.candidates{margin:0;display:grid;grid-template-columns:1fr 1fr;gap:10px;font-size:12px;line-height:1.4}
.candidate{min-width:0}.candidate dt{margin:0;font-weight:500}.candidate dd{margin:2px 0 0;color:var(--color-text-muted)}
.candidate:global(.expected) dt{text-decoration:underline;text-decoration-style:dotted;text-underline-offset:4px}
.candidate:global(.selected) dt,.candidate:global(.selected) dd{color:#425743}
.fine-print{font-size:12px;line-height:1.45;color:var(--color-text-muted);margin:9px 0 0}
h2{font:normal 22px/1.35 var(--font-serif);letter-spacing:-.25px;margin:0 0 9px}
.section-label{font:500 12px/1.5 -apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;letter-spacing:.075em;text-transform:uppercase;margin:0;color:var(--color-text-muted)}
.research-intro{padding:22px 0 25px}
.research-intro .section-label{margin-bottom:7px}
.research-intro>p{margin:0;max-width:900px;font-size:14px;line-height:1.65}
.programme-loop{margin:17px 0 0;display:grid;grid-template-columns:1fr 1.4fr 1fr;column-gap:38px;position:relative}
.programme-stage{position:relative;font-size:13px;line-height:1.5}
.programme-stage:not(:last-child)::after{content:'→';position:absolute;right:-27px;top:0;color:var(--color-text-muted)}
.programme-stage strong{font-weight:500;display:block}
.programme-stage span{display:block;color:var(--color-text-muted);font-size:12px;margin-top:2px}
.programme-return{display:flex;align-items:center;gap:12px;color:var(--color-accent);font-size:12px;margin:10px 0 0}
.programme-return::after{content:'';height:1px;flex:1;background:var(--color-border)}
.programme-return a{white-space:nowrap}
.work-group{margin-top:19px}
.group-heading{display:flex;align-items:baseline;gap:20px;margin-bottom:9px}
.group-heading h3{font:normal 20px/1.4 var(--font-serif);margin:0}
.group-heading p{color:var(--color-text-muted);font-size:12px;margin:0}
.work-pair{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.work-card{border:1px solid var(--color-border);padding:14px 17px 13px;display:flex;flex-direction:column;transition:border-color 150ms,background-color 150ms;min-width:0}
.work-card:hover,.work-card:focus-within{border-color:#b39b8d;background:#f5f1e9}
.work-kind{font-size:12px;color:var(--color-accent);margin:0 0 6px;line-height:1.5;font-weight:500}
.work-card h4,.methods h3{font:normal 20px/1.35 var(--font-serif);margin:0 0 6px}
.work-card h4 a,.methods h3 a{text-decoration:none}
.work-copy{margin:0 0 9px;font-size:14px;line-height:1.6;text-wrap:pretty}
.status{font-size:12px;line-height:1.5;color:var(--color-text-muted);margin:auto 0 0}
.methods{border-top:1px solid var(--color-border);border-bottom:1px solid var(--color-border);padding:17px 0;margin-top:22px;display:grid;grid-template-columns:245px 1fr;gap:26px}
.methods .work-kind{margin-bottom:5px}.methods .work-copy{margin-bottom:5px}
.more{font-size:13px;margin:14px 0 0}
@media(max-width:900px){.page{padding:0 26px}nav{gap:15px}.opening{grid-template-columns:minmax(0,1fr) 250px;gap:25px}.utterances li{font-size:20px}.notes{padding-left:17px}}
@media(max-width:680px){
 .page{padding:0 21px}header{display:flex;align-items:baseline;padding:16px 0 13px;min-height:0;gap:17px}.home{font-size:12px}nav{margin:0;gap:7px 16px;line-height:1.5}
 main{padding-top:23px}.identity{margin-bottom:19px}h1{font-size:29px}.affiliation{font-size:13px}.contact-line{gap:5px 13px}
 .opening{display:block;padding:15px 0 13px}.scene{font-size:14px;margin-bottom:8px}.utterances{gap:6px}.utterances li{font-size:20px;line-height:1.4}.word{max-width:100%}.hint{margin-top:9px}.desktop-hint{display:none}.mobile-hint{display:inline}
 .notes{margin-top:13px;min-height:0;padding:10px 0 0;border-left:0;border-top:1px solid var(--color-border)}.note-copy{min-height:0;margin:9px 0;font-size:14px}.candidates{max-width:340px}.fine-print{margin-top:8px}
 .research-fields{font-size:13px;max-width:300px}
 .research-intro{padding:21px 0 23px}h2{font-size:21px}.research-intro>p{font-size:14px}
 .programme-loop{grid-template-columns:1fr;row-gap:18px;margin-top:15px;padding-left:13px;border-left:1px solid var(--color-border)}
 .programme-stage:not(:last-child)::after{content:'↓';right:auto;left:-18px;top:auto;bottom:-18px;background:var(--color-bg);font-size:12px}
 .programme-stage span{margin-top:1px}.programme-return{flex-wrap:wrap;gap:3px 12px}.programme-return::after{display:none}
 .group-heading{display:block}.group-heading p{margin-top:3px}.work-pair{grid-template-columns:1fr;gap:10px}
 .work-card{padding:13px 15px}.methods{grid-template-columns:1fr;gap:3px}.methods h3{font-size:20px}.work-group{margin-top:17px}
}
@media(prefers-reduced-motion:reduce){*{transition:none!important;scroll-behavior:auto!important}}

/* The 22 September approved preview is scoped to the homepage. */
:global(body.homepage) {
 --color-bg:#faf8f4; --color-text:#302d28; --color-text-muted:#6d6258; --color-text-dim:#6d6258;
 --color-accent:#963f2d; --color-border:#ded8cf; --color-border-strong:#b39b8d; --color-surface:#f5f1e9;
 --nav-bg:#faf8f4; --nav-border:#ded8cf;
 --font-sans:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
 --font-serif:Charter,"Bitstream Charter",Georgia,serif;
 --font-display:Charter,"Bitstream Charter",Georgia,serif;
 background:var(--color-bg);color:var(--color-text);font-family:var(--font-sans);
}
:global(body.homepage .site-nav){position:static;height:auto;min-height:58px;border:0}
:global(body.homepage .site-nav-inner){max-width:1060px;margin:auto;padding:0 34px;min-height:58px;gap:25px}
:global(body.homepage .site-nav-inner)::after{display:none}
:global(body.homepage .site-brand)::before{display:none}
:global(body.homepage .wordmark){font:13px/1.2 var(--font-sans)}
:global(body.homepage .nav-links){display:flex;flex-wrap:wrap;gap:22px}
:global(body.homepage .nav-link){font:12px/1.5 var(--font-sans);letter-spacing:0;text-transform:none}
:global(body.homepage .page-main){padding-top:0}
:global(body.homepage .site-footer){background:var(--color-bg);color:var(--color-text-muted)}
