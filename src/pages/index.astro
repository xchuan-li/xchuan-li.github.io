---
import Base from "../layouts/Base.astro";
import { projects, now } from "../data/research";
import { posts } from "../data/writing";
import { criteria, currentQuestionHtml, identityLongHtml } from "../data/program";

// The homepage is a plain, single-column academic page: a header (photo + name +
// affiliation + a two-sentence research statement + links), then the research
// question and the criteria that make it falsifiable, the work with concrete
// output, a short "currently", and recent writing. No hero, no scroll animation,
// no CTA buttons — the register a formal-semantics / cognitive-science reader
// expects. All positioning copy comes from data/program.ts; project records from
// data/research.ts.
//
// (This replaced the scroll-portfolio hero in 2026-09. The plain mirror that used
// to live at /plain was merged in here; /plain now redirects to /.)
//
// PHOTO SLOT: drop a headshot at `public/images/headshot.jpg` (square, ~400×400+)
// and it appears in the header automatically — the `.headshot` box paints it as a
// background, so a missing file just shows a clean empty avatar frame, never a
// broken image. To use a different filename/format, change the url() in the
// `.headshot` rule below.

const built = projects.filter((p) => !p.parked);
const recentPosts = posts.slice(0, 5);
---

<Base>
  <article class="home">
    <header class="lede">
      <div class="lede-top">
        <div class="headshot" role="img" aria-label="Portrait of Xiaochuan Li"></div>
        <div class="lede-id">
          <h1 class="name">Xiaochuan Li</h1>
          <p class="affil">M.Sc. Human and AI · University of Technology Nuremberg (UTN)</p>
          <p class="links">
            <a href="mailto:xiaochuan.li@utn.de">xiaochuan.li@utn.de</a>
            <span class="sep">·</span>
            <a href="/cv">CV</a>
            <span class="sep">·</span>
            <a href="https://github.com/xchuan-li" rel="noopener">GitHub</a>
            <span class="sep">·</span>
            <a href="https://www.linkedin.com/in/xiaochuan-li-0488533b5/" rel="noopener" target="_blank">LinkedIn</a>
          </p>
        </div>
      </div>
      <p class="stmt" set:html={identityLongHtml} />
      <p class="stmt" set:html={currentQuestionHtml} />
      <p class="stmt-note">Applying for PhD positions for fall 2027.</p>
    </header>

    <section class="block">
      <h2 class="h2">Research</h2>
      <p class="para">
        Someone says <em>“It might be a star.”</em> Does that merely signal uncertainty, or does it
        also help maintain <em>the star</em> as a live alternative for the reasoning that follows? For
        that to be a real effect rather than mention, priming, or generic uncertainty, it should be
        {criteria.map((c, i) => (
          <>{i === criteria.length - 1 ? ", and " : i > 0 ? ", " : " "}<strong>{c.name}</strong> ({c.text})</>
        ))}. Right now the construct brief — the target and these diagnostics — is under review by a
        formal semanticist, before any model or behavioural study. The full case is on the <a href="/research">research page</a>; how a linguistic question becomes evidence is on the <a href="/approach">approach page</a>.
      </p>
    </section>

    <section class="block">
      <h2 class="h2">Selected work</h2>
      <p class="block-note">
        The concrete output behind the current question, and where the engineering came from — a
        first-author paper, a DFKI collaboration, and the earlier pilot that built the methods. Not the
        research identity; the evidence that it can be executed.
      </p>
      <ul class="work">
        {built.map((p) => (
          <li class="work-item">
            <div class="work-top">
              <a class="work-title" href={p.href}>{p.title}</a>
              <span class="work-tag">{p.output}</span>
            </div>
            <p class="work-desc">{p.short ?? p.blurb}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="block">
      <h2 class="h2">Currently</h2>
      <ul class="now">
        {now.map((item) => (
          <li><span class="now-label">{item.label}</span> {item.text}</li>
        ))}
      </ul>
    </section>

    <section class="block">
      <h2 class="h2">Writing</h2>
      <ul class="writing">
        {recentPosts.map((p) => (
          <li>
            <a href={`/writing/${p.slug}`}>{p.title}</a>
            <span class="writing-date">{p.date}{p.status === "draft" ? " · draft" : ""}</span>
          </li>
        ))}
      </ul>
      <p class="more"><a href="/writing">All writing →</a></p>
    </section>
  </article>
</Base>

<style>
  .home { max-width: 42rem; }

  /* ---- header ---- */
  .lede { margin-bottom: 1rem; }
  .lede-top {
    display: flex;
    align-items: center;
    gap: 1.4rem;
    margin-bottom: 1.6rem;
  }
  .headshot {
    flex: none;
    width: 112px;
    height: 112px;
    border-radius: 10px;
    border: 1px solid var(--color-border);
    background-color: var(--color-surface-2);
    background-image: url("/images/headshot.jpg");
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }
  .name {
    font-family: var(--font-display);
    font-size: 1.9rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    margin: 0 0 0.3rem;
    color: var(--color-text);
  }
  .affil { font-size: 0.9rem; color: var(--color-text-muted); margin: 0 0 0.65rem; }
  .links { font-size: 0.9rem; color: var(--color-text-muted); margin: 0; line-height: 1.85; }
  .links a { color: var(--color-accent); text-decoration: none; }
  .links a:hover { text-decoration: underline; }
  .links .sep { color: var(--color-text-ghost); margin: 0 0.5rem; }

  .stmt {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-text);
    margin: 0 0 1.1rem;
  }
  .stmt strong { font-weight: 600; }
  .stmt em { font-style: italic; }
  .stmt-note { font-size: 0.9rem; color: var(--color-text-muted); margin: 0.3rem 0 0; }

  @media (max-width: 520px) {
    .lede-top { gap: 1.1rem; }
    .headshot { width: 88px; height: 88px; }
    .name { font-size: 1.65rem; }
  }

  /* ---- sections ---- */
  .block { margin-top: 3rem; }
  .h2 {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-text-dim);
    margin: 0 0 1.25rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--color-border);
  }
  .para {
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--color-text-muted);
    margin: 0;
  }
  .para em { font-style: italic; color: var(--color-text); }
  .para strong { color: var(--color-text); font-weight: 600; }
  .para a { color: var(--color-accent); text-decoration: none; }
  .para a:hover { text-decoration: underline; }
  .block-note {
    font-size: 0.92rem;
    line-height: 1.65;
    color: var(--color-text-muted);
    font-style: italic;
    margin: 0 0 1.4rem;
  }

  /* ---- work ---- */
  .work { list-style: none; margin: 0; padding: 0; }
  .work-item {
    padding: 1.05rem 0;
    border-bottom: 1px solid var(--color-border);
  }
  .work-item:first-child { border-top: 1px solid var(--color-border); }
  .work-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 0.4rem;
  }
  .work-title { font-size: 1.02rem; font-weight: 500; color: var(--color-text); text-decoration: none; }
  .work-title:hover { color: var(--color-accent); }
  .work-tag {
    flex: none;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-dim);
    white-space: nowrap;
  }
  .work-desc { font-size: 0.9rem; line-height: 1.65; color: var(--color-text-muted); margin: 0; }

  /* ---- currently ---- */
  .now { list-style: none; margin: 0; padding: 0; }
  .now li {
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--color-text-muted);
    margin-bottom: 0.85rem;
  }
  .now li:last-child { margin-bottom: 0; }
  .now-label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text);
    margin-right: 0.5rem;
  }

  /* ---- writing ---- */
  .writing { list-style: none; margin: 0; padding: 0; }
  .writing li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--color-border);
  }
  .writing li:first-child { border-top: 1px solid var(--color-border); }
  .writing a { color: var(--color-text); text-decoration: none; font-size: 0.98rem; }
  .writing a:hover { color: var(--color-accent); }
  .writing-date {
    flex: none;
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--color-text-dim);
    white-space: nowrap;
  }
  .more { margin: 1.1rem 0 0; font-size: 0.9rem; }
  .more a { color: var(--color-accent); text-decoration: none; }
  .more a:hover { text-decoration: underline; }
</style>
