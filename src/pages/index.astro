---
import Base from "../layouts/Base.astro";
import { openingQuestionsHtml, identityLongHtml } from "../data/program";
import { projects } from "../data/projects";

// Homepage. Section order: header → latest → selected research →
// background → contact. The middle section is a concise
// research index; full questions, methods, and evidence live on the linked pages.
//
// PHOTO: public/images/headshot.jpg (CSS background — a missing file just shows an
// empty frame). LOGOS: public/images/logos/{utn,marburg,szu}.svg in .tl-logo;
// circular emblems (emblem: true) are sized up to match the UTN wordmark.

// Selected research is organised on two axes: which case a project belongs to,
// and which kind of evidence it contributes. The evidence labels reuse the
// empirical approaches above, so the same kinds recur across both cases and the
// gaps stay visible — the typicality case has no human study, and no public model
// work belongs to the modality case yet.
const typicalityCase = [
  {
    title: projects.typicality.title,
    field: "Linguistic analysis",
    desc: "A description built on a category term can fit more than one candidate. The paper separates three conditions under which that happens, so the same choice is not read the same way in all three, and states what a forced choice can and cannot report.",
    status: projects.typicality.status,
    links: [{ label: "Paper and framing", href: projects.typicality.href }],
  },
  {
    title: projects.protobias.title,
    field: "Computational studies",
    desc: "Can models follow explicit semantic constraints despite prototypicality, and does this ability vary across languages? I test this with fixed image pairs across seven languages and two VLM systems.",
    status: "Completed study · First-author manuscript in revision",
    cover: {
      src: "/images/project-covers/protobias.png",
      alt: "Seven language prompts lead to a model choosing between fixed images of a duck beside two bamboo stalks and a panda among many bamboo stalks.",
    },
    note: {
      label: "Motive",
      side: "left",
      text: "A correct answer alone does not identify which information a model used. Competing explanations need controlled comparisons.",
    },
    links: [{ label: "Study and results", href: projects.protobias.href }],
  },
];

const modalityCase = [
  {
    title: projects.threeWays.title,
    field: "Linguistic analysis",
    desc: "A formal semantic and pragmatic comparison of <em>might p</em>, <em>might p or might not p</em>, and <em>I don’t know whether p</em>, examining the commitments they create and the responses they license.",
    status: projects.threeWays.status,
    links: [{ label: "Paper and diagnostics", href: projects.threeWays.href }],
  },
  {
    title: projects.thesis.title,
    field: "Human studies",
    desc: projects.thesis.summary,
    status: projects.thesis.status,
    note: {
      label: "Connection",
      side: "right",
      text: "The formal analysis identifies a contrast. A behavioural study could test what that contrast changes for a listener.",
    },
    links: [{ label: "Master’s thesis", href: projects.thesis.href }],
  },
];

const methodsWork = [
  {
    title: projects.latentControl.title,
    field: "Mechanistic interpretability",
    desc: "A DFKI collaboration developing my training in explaining model decisions: from controlled behavioural contrasts to tests of which internal representations and computations contribute to an answer.",
    status: "Behavioural pilots · Mechanistic tests in development",
    links: [{ label: "Project and methods", href: projects.latentControl.href }],
  },
];

// Latest keeps one line per real event. An empty or padded list is worse than a
// short one — only add items that actually happened.
const latest = [
  {
    date: "September 2026",
    html: 'Working paper out: <a href="/research/typicality-in-referent-choice">Typicality in referent choice: what the description leaves open</a> — <a href="https://lingbuzz.net/lingbuzz/010343" rel="noopener">lingbuzz/010343</a>, <a href="https://doi.org/10.5281/zenodo.22855036" rel="noopener">doi:10.5281/zenodo.22855036</a>.',
  },
];

const researchGroups = [
  {
    label: "Typicality and reference",
    blurb: "The earlier case. A description built on a category term narrows to one candidate; this work concerns where that narrowing lands.",
    related: true,
    projects: typicalityCase,
  },
  {
    label: "Epistemic modality",
    blurb: "The current case, and the same kind of event seen from the other side: whether a possibility is held open after <em>might p</em>, and whether later evidence revises it. This is a direction rather than a result — the behavioural study has not begun.",
    related: true,
    projects: modalityCase,
  },
  {
    label: "Methods",
    blurb: "Training in explaining model decisions, carried into both cases.",
    projects: methodsWork,
  },
];

// Background: the questions belong to each period as they were then, so they change
// stage by stage rather than restating the current program in the past.
const timeline = [
  {
    period: "2020 – 2024",
    logo: "/images/logos/szu.svg",
    emblem: true,
    org: "Shenzhen University",
    role: "B.A. Philosophy",
    phase: "The formal question",
    did: "Philosophy of language, analytic philosophy, and logic — with a senior thesis on Leibniz’s <em>characteristica universalis</em>, a notation whose form was meant to mirror the structure of thought.",
    groups: [
      {
        questions: [
          "Can reasoning be represented in a systematic symbolic form?",
          "What makes an inference valid?",
          "What is gained — and lost — when natural language is translated into logic?",
        ],
      },
    ],
  },
  {
    period: "2024 – 2025",
    logo: "/images/logos/marburg.svg",
    emblem: true,
    org: "University of Marburg",
    role: "Student · Preparatory Studies",
    phase: "Meaning across linguistic forms",
    did: "A year of preparatory studies as an enrolled student, learning German for graduate work — reading the same meanings through German, Chinese, and English.",
    groups: [
      {
        questions: [
          "How can similar content be expressed through different grammatical systems?",
          "Which parts of an interpretation are encoded, and which are supplied by context?",
          "What remains stable when meaning moves across languages?",
        ],
      },
    ],
  },
  {
    period: "2025 – present",
    logo: "/images/logos/utn.svg",
    org: "University of Technology Nuremberg (UTN)",
    role: "M.Sc. Human and Artificial Intelligence",
    phase: "From formal questions to empirical methods",
    did: "Graduate training in cognitive psychology, experimental design and statistics, deep learning, and interpretability, connecting linguistic questions with evidence from human behaviour and computational models.",
    groups: [
      {
        label: "Methods and evidence",
        questions: [
          "How can behavioural experiments distinguish competing accounts of meaning?",
          "How can controlled contrasts separate semantic sensitivity from surface shortcuts?",
          "When is an internal representation causally relevant to behaviour?",
        ],
      },
      {
        label: "Current case study",
        questions: [
          "What exactly does an epistemic possibility expression contribute to discourse?",
          "Does the linguistic contrast affect how people subsequently use a possibility?",
          "What would a model need to learn to reproduce that behaviour?",
        ],
      },
    ],
  },
];


---

<Base wide={true}>
  <div class="wrap">
    <!-- ===== header ===== -->
    <header class="hd">
      <div class="hd-main">
        <h1 class="hd-name">Xiaochuan Li</h1>
        <p class="hd-tag" set:html={openingQuestionsHtml} />
        <p class="hd-tag hd-tag-work" set:html={identityLongHtml} />
        <p class="hd-affil">
          M.Sc. Human and AI · University of Technology Nuremberg · applying for PhD positions beginning in fall 2027
        </p>
        <p class="hd-links">
          <a href="mailto:xiaochuan.li@utn.de">xiaochuan.li@utn.de</a>
          <span class="sep">·</span>
          <a href="/approach">Research Program</a>
          <span class="sep">·</span>
          <a href="/cv">CV</a>
          <span class="sep">·</span>
          <a href="https://github.com/xchuan-li" rel="noopener">GitHub</a>
        </p>
      </div>
      <div class="hd-photo" role="img" aria-label="Portrait of Xiaochuan Li"></div>
    </header>

    <!-- ===== latest ===== -->
    <section class="sec" aria-labelledby="latest-heading">
      <h2 class="sec-h" id="latest-heading">Latest</h2>
      <ul class="latest-list">
        {latest.map((item) => (
          <li class="latest-item">
            <span class="latest-date">{item.date}</span>
            <span class="latest-text" set:html={item.html} />
          </li>
        ))}
      </ul>
    </section>

    <!-- ===== selected research ===== -->
    <section class="sec selected-research" id="selected-research" aria-labelledby="research-heading">
      <h2 class="sec-h" id="research-heading">Selected research</h2>
      <div class="research-list">
        {researchGroups.map((group) => (
          <div class="research-block">
            <p class="research-group-label">{group.label}</p>
            <p class="research-group-blurb" set:html={group.blurb} />
            <div class:list={["research-group", { "research-pair": group.related }]} role={group.related ? "group" : undefined} aria-label={group.label}>
        {group.projects.map((project) => (
          <article class="research-entry">
            <div class="research-side">
              <p class="research-field">{project.field}</p>
              {project.note && (
                <aside class={`research-note research-note-${project.note.side}`} aria-label={`${project.note.label} annotation`}>
                  <p class="research-note-label">{project.note.label}</p>
                  <p class="research-note-text">{project.note.text}</p>
                </aside>
              )}
            </div>
            <div class="research-copy">
              <h3 class="research-title">{project.title}</h3>
              <div class:list={["research-detail", { "research-detail-illustrated": project.cover }]}>
                <div>
                  <p class="research-desc" set:html={project.desc} />
                  <p class="research-status">{project.status}</p>
                  <p class="research-links">
                    {project.links.map((link) => <a class="research-project-link" href={link.href}>{link.label} <span aria-hidden="true">→</span></a>)}
                  </p>
                </div>
                {project.cover && (
                  <a class="research-cover" href={project.links[0].href} aria-label={`Open ${project.title}`}>
                    <img src={project.cover.src} alt={project.cover.alt} width="1200" height="720" loading="lazy" decoding="async" />
                  </a>
                )}
              </div>
            </div>
          </article>
        ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ===== background ===== -->
    <section class="sec">
      <h2 class="sec-h">Background</h2>
      <div class="tl">
        {timeline.map((t) => (
          <div class="tl-item">
            <div class="tl-aside">
              <div class={`tl-logo${t.emblem ? " emblem" : ""}`}>
                <img src={t.logo} alt={`${t.org} logo`} />
              </div>
              <div class="tl-period">{t.period}</div>
            </div>
            <div class="tl-body">
              <h3 class="tl-org">{t.org}</h3>
              <p class="tl-role">{t.role}</p>
              <p class="tl-phase">{t.phase}</p>
              <p class="tl-did" set:html={t.did} />
              {t.groups.map((g) => (
                <div class="tl-group">
                  {g.label && <p class="tl-group-label">{g.label}</p>}
                  <ul class="tl-qs">
                    {g.questions.map((q) => <li set:html={q} />)}
                  </ul>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ===== contact ===== -->
    <section class="sec">
      <div class="cta">
        <p class="cta-line">Currently applying for PhD positions beginning in fall 2027 — email is the best way to get in touch.</p>
        <p class="cta-links">
          <a href="mailto:xiaochuan.li@utn.de">Email me</a>
          <span class="sep">·</span>
          <a href="/contact">More ways to get in touch</a>
        </p>
      </div>
    </section>
  </div>
</Base>

<style>
  .wrap { max-width: 940px; margin: 0 auto; padding: 2.75rem 1.5rem 5rem; font-family: var(--font-sans); }

  /* ===== header ===== */
  .hd { display: flex; align-items: center; justify-content: space-between; gap: 2.5rem; margin-bottom: 1rem; }
  .hd-photo {
    flex: none;
    width: 208px;
    height: 260px;
    border-radius: 14px;
    border: 1px solid var(--color-border);
    background-color: var(--color-surface-2);
    background-image: url("/images/headshot.jpg");
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }
  .hd-main { min-width: 0; }
  .hd-name { font-family: var(--font-display); font-size: 2.5rem; font-weight: 600; letter-spacing: -0.02em; margin: 0 0 0.6rem; color: var(--color-text); line-height: 1.05; }
  .hd-tag { font-size: 1.15rem; line-height: 1.5; color: var(--color-text); margin: 0 0 0.7rem; max-width: 34rem; }
  .hd-tag :global(strong) { font-weight: 600; }
  .hd-tag :global(em) { font-style: italic; }
  .hd-tag-work { font-size: 1.02rem; color: var(--color-text-muted); margin: 0 0 0.9rem; }
  .hd-tag-work :global(em) { font-style: italic; color: var(--color-text); }
  .hd-affil { font-size: 0.9rem; color: var(--color-text-muted); margin: 0 0 0.8rem; line-height: 1.5; }
  .hd-links { font-family: var(--font-mono); font-size: 0.8rem; letter-spacing: 0.01em; color: var(--color-text-muted); margin: 0; }
  .hd-links a { color: var(--color-accent); text-decoration: none; }
  .hd-links a:hover { text-decoration: underline; }
  .hd-links .sep { color: var(--color-text-ghost); margin: 0 0.45rem; }

  @media (max-width: 620px) {
    .hd { flex-direction: column; align-items: flex-start; gap: 1.4rem; }
    .hd-photo { order: -1; width: 168px; height: 210px; }
    .hd-name { font-size: 2rem; }
    .hd-tag { font-size: 1.05rem; }
  }

  /* ===== research program ===== */
  .scope { margin-top: 2.6rem; padding: 1.45rem 0 1.6rem; border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); }
  .scope-heading { font-family: var(--font-mono); font-size: 10.5px; font-weight: 500; letter-spacing: 0.2em; text-transform: uppercase; color: var(--color-text-dim); margin: 0 0 0.85rem; }
  .scope-intro { max-width: 45rem; }
  .scope-title { font-family: var(--font-serif); font-size: 1.9rem; font-weight: 600; letter-spacing: -0.015em; line-height: 1.2; color: var(--color-text); margin: 0 0 0.55rem; }
  .scope-lede { font-size: 0.98rem; line-height: 1.7; color: var(--color-text-muted); margin: 0; }
  .scope-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem; margin-top: 1.35rem; padding-top: 1.15rem; border-top: 1px solid var(--color-border); }
  .scope-item { min-width: 0; }
  .scope-label { font-family: var(--font-mono); font-size: 9.5px; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-accent); margin: 0 0 0.3rem; }
  .scope-path-title { font-family: var(--font-sans); font-size: 0.98rem; font-weight: 600; letter-spacing: -0.005em; color: var(--color-text); margin: 0 0 0.35rem; }
  .scope-desc { font-size: 0.88rem; line-height: 1.58; color: var(--color-text-muted); margin: 0; }
  .scope-link { margin: 1.15rem 0 0; font-size: 0.88rem; }
  .scope-link a { color: var(--color-accent); text-decoration: none; }
  .scope-link a:hover { text-decoration: underline; }

  @media (max-width: 680px) {
    .scope-title { font-size: 1.65rem; }
    .scope-grid { grid-template-columns: 1fr; gap: 1.15rem; }
  }

  /* ===== section frame ===== */
  .sec { margin-top: 3.6rem; }
  .sec-h {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-text-dim);
    margin: 0 0 1.4rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--color-border);
  }
  .sec-h::before { content: "// "; color: var(--color-accent); opacity: 0.6; }

  .block-note { font-size: 0.95rem; line-height: 1.65; color: var(--color-text-muted); margin: 0 0 1.4rem; }

  /* ===== latest ===== */
  .latest-list { list-style: none; margin: 1rem 0 0; padding: 0; display: grid; gap: 0.5rem; }
  .latest-item { display: grid; grid-template-columns: 140px minmax(0, 1fr); gap: 1.75rem; font-size: 0.93rem; line-height: 1.6; }
  .latest-date { font-family: var(--font-mono); font-size: 0.79rem; color: var(--color-text-dim); padding-top: 0.15rem; }
  .latest-text { color: var(--color-text-muted); }
  .latest-text a { color: var(--color-accent); }
  @media (max-width: 720px) {
    .latest-item { grid-template-columns: 1fr; gap: 0.15rem; }
  }

  /* ===== research cards — original lift, shadow, title and cover feedback ===== */
  .selected-research { scroll-margin-top: 6rem; }
  .selected-research .sec-h { margin-bottom: 0; }
  .research-list { display: grid; gap: 2.4rem; margin-top: 1.2rem; }
  .research-block { display: grid; gap: 0.55rem; min-width: 0; }
  .research-group-label {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-text);
    margin: 0;
  }
  .research-group-blurb { font-size: 0.9rem; line-height: 1.6; color: var(--color-text-muted); margin: 0 0 0.35rem; max-width: 46rem; }
  .research-group-blurb em { font-style: italic; color: var(--color-text); }
  .research-group { display: grid; gap: 1rem; min-width: 0; }
  .research-pair { padding: 0.75rem; border: 1px solid var(--color-border); border-radius: 16px; }
  .research-entry {
    position: relative;
    display: grid;
    grid-template-columns: 140px minmax(0, 1fr);
    gap: 1.75rem;
    padding: 1.4rem 1.5rem;
    border: 1px solid var(--card-border);
    border-radius: 12px;
    background: var(--card-bg);
    transition: transform 0.2s ease, box-shadow 0.25s ease, border-color 0.2s ease;
  }
  .research-entry:hover, .research-entry:focus-within {
    transform: translateY(-3px);
    box-shadow: 0 14px 30px -14px rgba(23, 33, 48, 0.28);
    border-color: var(--card-hover-border);
  }
  .research-field { font-size: 0.79rem; line-height: 1.5; color: var(--color-accent); margin: 0.25rem 0 0; }
  .research-copy { min-width: 0; }
  .research-detail-illustrated { display: grid; grid-template-columns: minmax(0, 1fr) 250px; gap: 1.25rem; align-items: start; }
  .research-cover { display: block; border-radius: 8px; overflow: hidden; }
  .research-cover img { display: block; width: 100%; height: auto; transition: transform 0.35s ease; }
  .research-entry:hover .research-cover img, .research-entry:focus-within .research-cover img { transform: scale(1.03); }
  .research-cover:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 4px; }
  .research-note { position: relative; z-index: 2; margin-top: 1.2rem; padding-left: 0.7rem; border-left: 1px solid var(--color-border-strong); }
  .research-note-label { font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-accent); margin: 0 0 0.45rem; }
  .research-note-text { font-size: 0.76rem; line-height: 1.6; color: var(--color-text-muted); margin: 0; }
  .research-title { font-family: var(--font-serif); font-size: 1.45rem; font-weight: 500; line-height: 1.25; color: var(--color-text); margin: 0 0 0.55rem; transition: color 0.2s ease; }
  .research-entry:hover .research-title, .research-entry:focus-within .research-title { color: var(--color-accent); }
  .research-desc { font-size: 0.94rem; line-height: 1.65; color: var(--color-text-muted); margin: 0 0 0.6rem; }
  .research-desc :global(em) { font-style: italic; color: var(--color-text); }
  .research-status { font-size: 0.78rem; line-height: 1.5; color: var(--color-text-muted); margin: 0 0 0.5rem; }
  .research-links { display: flex; flex-wrap: wrap; gap: 0.4rem 1.4rem; font-size: 0.85rem; margin: 0; }
  .research-links a { color: var(--color-accent); text-decoration: none; text-underline-offset: 0.2em; }
  .research-project-link::after { content: ""; position: absolute; inset: 0; z-index: 1; border-radius: 12px; }
  .research-links a:hover { text-decoration: underline; }
  .research-links a:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 4px; }
  .research-project-link:focus-visible::after { outline: 2px solid var(--color-accent); outline-offset: 3px; }
  @media (min-width: 1280px) {
    .research-note { position: absolute; top: 1.8rem; width: clamp(8.5rem, calc((100vw - 940px) / 2 - 2.5rem), 11rem); margin-top: 0; }
    .research-note-right { left: calc(100% + 1.75rem); }
    .research-note-left { right: calc(100% + 1.75rem); }
  }
  @media (min-width: 621px) and (max-width: 900px) {
    .research-detail-illustrated { grid-template-columns: 1fr; gap: 1rem; }
    .research-cover { max-width: 300px; }
  }
  @media (max-width: 620px) {
    .research-pair { padding: 0.5rem; }
    .research-entry { grid-template-columns: 1fr; gap: 0.5rem; padding: 1.2rem 1rem; }
    .research-side { display: contents; }
    .research-field { margin: 0; }
    .research-copy { order: 1; }
    .research-title { font-size: 1.35rem; }
    .research-detail-illustrated { grid-template-columns: 1fr; gap: 1rem; }
    .research-cover { order: -1; max-width: 360px; }
    .research-note { order: 2; margin-top: 0.5rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .research-entry, .research-title, .research-cover img { transition: none; }
    .research-entry:hover, .research-entry:focus-within,
    .research-entry:hover .research-cover img, .research-entry:focus-within .research-cover img { transform: none; }
  }

  /* ===== timeline ===== */
  .tl { display: flex; flex-direction: column; gap: 2rem; }
  .tl-item { display: grid; grid-template-columns: 150px minmax(0, 1fr); gap: 1.75rem; }
  .tl-aside { display: flex; flex-direction: column; align-items: flex-start; gap: 0.6rem; }
  .tl-logo { min-height: 48px; display: flex; align-items: center; }
  .tl-logo img { height: 36px; width: auto; max-width: 124px; display: block; }
  .tl-logo.emblem img { height: 78px; }
  .tl-period { font-family: var(--font-mono); font-size: 11.5px; letter-spacing: 0.03em; color: var(--color-text-dim); }
  .tl-org { font-family: var(--font-sans); font-size: 1.08rem; font-weight: 600; color: var(--color-text); margin: 0 0 0.15rem; letter-spacing: -0.005em; }
  .tl-role { font-size: 0.92rem; color: var(--color-text-muted); margin: 0 0 0.4rem; }
  .tl-phase { font-family: var(--font-sans); font-size: 0.95rem; font-weight: 600; color: var(--color-accent); margin: 0 0 0.6rem; }
  .tl-did { font-size: 0.95rem; line-height: 1.65; color: var(--color-text-muted); margin: 0 0 0.6rem; }
  .tl-did :global(em) { font-style: italic; }
  .tl-group { margin-top: 0.85rem; }
