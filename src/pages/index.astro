---
import Base from "../layouts/Base.astro";
import { posts } from "../data/writing";
import { openingQuestionsHtml, identityLongHtml } from "../data/program";
import { projects } from "../data/projects";

// Homepage (A3g §5). Section order: header → current work → selected work →
// research program preview → writing → timeline → playground → contact. Research
// evidence comes before biography, so the timeline sits below the projects. The
// identity line comes from data/program.ts; page-specific copy lives here.
//
// PHOTO: public/images/headshot.jpg (CSS background — a missing file just shows an
// empty frame). LOGOS: public/images/logos/{utn,marburg,szu}.svg in .tl-logo;
// circular emblems (emblem: true) are sized up to match the UTN wordmark.

// Related theoretical and proposed empirical work; thesis scope remains open.
const currentProgram = [
  {
    n: "01",
    phase: "Define the distinction",
    title: "Three Ways of Leaving <em>p</em> Unsettled",
    href: "/research/three-ways",
    cover: "/images/project-covers/three-ways.png",
    coverAlt: "Three semantic states showing one-sided possibility, bilateral openness, and unresolved knowledge",
    desc: `${projects.threeWays.question} ${projects.threeWays.summary}`,
    meta: projects.threeWays.status,
  },
  {
    n: "02",
    phase: "Develop an empirical question",
    title: projects.thesis.title,
    href: projects.thesis.href,
    cover: undefined,
    coverAlt: undefined,
    desc: `${projects.thesis.summary} ${projects.thesis.connection}`,
    meta: projects.thesis.status,
  },
];

// The three forms of training that define the broader application profile.
const researchAreas = [
  {
    label: "Formal structure",
    title: "Semantics and pragmatics",
    desc: "Explicit accounts of what utterances contribute, which alternatives they leave open, and which inferences they license.",
  },
  {
    label: "Human cognition",
    title: "Psycholinguistics",
    desc: "Questions about how meaning is represented, processed, updated, and learned, grounded in training in cognitive psychology and experimental methods.",
  },
  {
    label: "Computational systems",
    title: "Language models",
    desc: "Controlled evaluation of semantic sensitivity, framing, and competing cues, with learning and internal mechanisms as further research questions.",
  },
];

// Earlier model work that shaped the program's evidential standards.
const earlierWork = [
  {
    n: "01",
    phase: "Semantic evidence and prototypes",
    title: "Cross-lingual ProtoBias",
    href: "/research/cross-lingual-protobias",
    desc: `${projects.protobias.question} ${projects.protobias.summary} ${projects.protobias.connection}`,
    meta: projects.protobias.status,
  },
  {
    n: "02",
    phase: "Framing and model decisions",
    title: "Latent Control States",
    href: "/research/latent-control-states",
    desc: `${projects.latentControl.question} ${projects.latentControl.summary}`,
    meta: projects.latentControl.status,
  },
];

// Background: the questions belong to each period as they were then, so they change
// stage by stage rather than restating the current program in the past.
const timeline = [
  {
    period: "2020 – 2024",
    logo: "/images/logos/szu.svg",
    emblem: true,
    org: "Shenzhen University",
    role: "B.A. Philosophy",
    phase: "The formal question",
    did: "Philosophy of language, analytic philosophy, and logic — with a senior thesis on Leibniz’s <em>characteristica universalis</em>, a notation whose form was meant to mirror the structure of thought.",
    groups: [
      {
        questions: [
          "Can reasoning be represented in a systematic symbolic form?",
          "What makes an inference valid?",
          "What is gained — and lost — when natural language is translated into logic?",
        ],
      },
    ],
  },
  {
    period: "2024 – 2025",
    logo: "/images/logos/marburg.svg",
    emblem: true,
    org: "University of Marburg",
    role: "Student · Preparatory Studies",
    phase: "Meaning across linguistic forms",
    did: "A year of preparatory studies as an enrolled student, learning German for graduate work — reading the same meanings through German, Chinese, and English.",
    groups: [
      {
        questions: [
          "How can similar content be expressed through different grammatical systems?",
          "Which parts of an interpretation are encoded, and which are supplied by context?",
          "What remains stable when meaning moves across languages?",
        ],
      },
    ],
  },
  {
    period: "2025 – present",
    logo: "/images/logos/utn.svg",
    org: "University of Technology Nuremberg (UTN)",
    role: "M.Sc. Human and Artificial Intelligence",
    phase: "From formal questions to empirical methods",
    did: "Graduate training in cognitive psychology, experimental design and statistics, deep learning, and interpretability, connecting linguistic questions with evidence from human behaviour and computational models.",
    groups: [
      {
        label: "Methods and evidence",
        questions: [
          "How can behavioural experiments distinguish competing accounts of meaning?",
          "How can controlled contrasts separate semantic sensitivity from surface shortcuts?",
          "When is an internal representation causally relevant to behaviour?",
        ],
      },
      {
        label: "Current case study",
        questions: [
          "What exactly does an epistemic possibility expression contribute to discourse?",
          "Does the linguistic contrast affect how people subsequently use a possibility?",
          "What would a model need to learn to reproduce that behaviour?",
        ],
      },
    ],
  },
];

const playground = [
  {
    variant: "relay",
    title: "RELAY",
    tag: "Language-puzzle game",
    href: "/relay/",
    cta: "Play the prototype",
    steps: ["Observe", "Infer", "Compose"],
    desc: "You’re handed a machine that speaks a language nobody taught you. Feed it inputs, watch how it answers, and reverse-engineer the rules — then compose a brand-new utterance and see whether it actually gets through.",
  },
  {
    variant: "im",
    title: "Information Machines",
    tag: "Constructed language",
    href: "/information-machines",
    cta: "Read the design log",
    steps: ["Add", "Link", "Revise", "Retract"],
    desc: "A language whose grammar has a single job: move information around — introduce a fact, link it to what came before, revise it, take it back. It grows slowly, kept honest with a changelog and a suite of tests.",
  },
];

const featured = posts.find((p) => p.featured) ?? posts[0];
---

<Base wide={true}>
  <div class="wrap">
    <!-- ===== header ===== -->
    <header class="hd">
      <div class="hd-main">
        <h1 class="hd-name">Xiaochuan Li</h1>
        <p class="hd-tag" set:html={openingQuestionsHtml} />
        <p class="hd-tag hd-tag-work" set:html={identityLongHtml} />
        <p class="hd-affil">
          M.Sc. Human and AI · University of Technology Nuremberg · applying for PhD positions beginning in fall 2027
        </p>
        <p class="hd-links">
          <a href="mailto:xiaochuan.li@utn.de">xiaochuan.li@utn.de</a>
          <span class="sep">·</span>
          <a href="/cv">CV</a>
          <span class="sep">·</span>
          <a href="https://github.com/xchuan-li" rel="noopener">GitHub</a>
        </p>
      </div>
      <div class="hd-photo" role="img" aria-label="Portrait of Xiaochuan Li"></div>
    </header>

    <!-- ===== research scope ===== -->
    <section class="scope" aria-labelledby="scope-heading">
      <h2 class="scope-heading" id="scope-heading">Research focus</h2>
      <div class="scope-grid">
        {researchAreas.map((area) => (
          <div class="scope-item">
            <p class="scope-label">{area.label}</p>
            <h3 class="scope-title">{area.title}</h3>
            <p class="scope-desc">{area.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ===== current case study ===== -->
    <section class="sec" id="current">
      <h2 class="sec-h">Current case study</h2>
      <h3 class="blk-h">Epistemic possibility as a test case</h3>
      <p class="blk-body">
        “The key might be in the drawer” and “I don’t know whether the key is in the drawer”
        express different claims. I am examining what each contributes to a conversation and
        whether those differences affect how a specific possibility is subsequently accessed and
        used. The linguistic analysis is in development; the empirical thesis is being scoped.
      </p>
      <div class="program">
        {currentProgram.map((p, i) => (
          <div class={`program-entry${i === 1 ? " annotation-anchor" : ""}`}>
            <a class:list={["proj-card", "proj-card-current", { "proj-card-text": !p.cover }]} href={p.href} aria-label={`Open ${p.title.replace(/<[^>]+>/g, "")}`}>
              <div class="proj-copy">
                <p class="proj-step"><span class="proj-step-n">{p.n}</span> {p.phase}</p>
                <span class="proj-title" set:html={p.title} />
                <p class="proj-desc" set:html={p.desc} />
                <p class="proj-tag">{p.meta}</p>
              </div>
              {p.cover && <div class="proj-figure">
                <img src={p.cover} alt={p.coverAlt} width="1200" height="720" loading="lazy" decoding="async" />
              </div>}
            </a>
            {i === 1 && (
              <>
                <aside class="margin-note margin-note-dependency" aria-label="Dependency annotation">
                  <div class="margin-note-head">
                    <span class="annotation-reg" aria-hidden="true">B</span>
                    <span class="margin-note-label">Connection</span>
                  </div>
                  <p>The formal analysis identifies a contrast. A behavioural study could test what that contrast changes for a listener.</p>
                </aside>
              </>
            )}
          </div>
        ))}
      </div>
      <p class="blk-link"><a href="/research">Read about the current work</a></p>
    </section>

    <!-- ===== why this program ===== -->
    <section class="sec" id="background-program">
      <h2 class="sec-h">Model research</h2>
      <div class="annotation-anchor">
        <p class="blk-body">
          These projects developed my experience in controlled model evaluation and collaborative
          experiment design. They also sharpened the question of how to identify the information
          responsible for a judgment.
        </p>
        <aside class="margin-note margin-note-left margin-note-motive" aria-label="Motivation annotation">
          <div class="margin-note-head">
            <span class="annotation-reg" aria-hidden="true">A</span>
            <span class="margin-note-label">Motive</span>
          </div>
          <p>A correct answer alone does not identify which information a model used. Competing explanations need controlled comparisons.</p>
        </aside>
      </div>
      <div class="shaped-list">
        {earlierWork.map((p) => (
          <a class="shaped" href={p.href} aria-label={`Open ${p.title}`}>
            <p class="shaped-step"><span class="shaped-step-n">{p.n}</span> {p.phase}</p>
            <span class="shaped-title">{p.title}</span>
            <p class="shaped-desc" set:html={p.desc} />
            {p.meta && <p class="shaped-meta">{p.meta}</p>}
          </a>
        ))}
      </div>
      <p class="argument-bridge">The projects ask different questions while sharing an emphasis on explicit contrasts, competing explanations, and careful measurement.</p>
    </section>

    <section class="sec" id="exploratory">
      <h2 class="sec-h">Exploratory work</h2>
      <h3 class="blk-h">{projects.propertyInheritance.title}</h3>
      <p class="blk-body">{projects.propertyInheritance.question} {projects.propertyInheritance.summary}</p>
      <p class="shaped-meta">{projects.propertyInheritance.status}</p>
      <p class="blk-link"><a href={projects.propertyInheritance.href}>Read about the question</a></p>
    </section>

    <!-- ===== research program preview ===== -->
    <section class="sec annotation-anchor program-preview">
      <h2 class="sec-h">Research program</h2>
      <h3 class="blk-h">Meaning and inference</h3>
      <p class="blk-body">
        The common question is how linguistic meaning guides inference, and which information people
        and models use. Formal analysis makes the distinctions precise; human experiments can test
        their consequences for processing; model studies can examine sensitivity, learning, and
        internal mechanisms. Each project makes a bounded contribution to this wider question.
      </p>
      <aside class="margin-note margin-note-left margin-note-boundary" aria-label="Boundary annotation">
        <div class="margin-note-head">
          <span class="annotation-reg" aria-hidden="true">C</span>
          <span class="margin-note-label">Boundary</span>
        </div>
        <p>Human processing and model learning require their own evidence. An effect in one system does not establish the same mechanism in the other.</p>
      </aside>
      <p class="blk-link"><a href="/approach">See the research program</a></p>
    </section>

    <!-- ===== writing ===== -->
    <section class="sec">
      <h2 class="sec-h">Writing</h2>
      {featured && (
        <a class="feat" href={`/writing/${featured.slug}`}>
          <span class="feat-title">{featured.title}</span>
          <span class="feat-excerpt">{featured.excerpt}</span>
        </a>
      )}
      <p class="more"><a href="/writing">All writing</a></p>
    </section>

    <!-- ===== background ===== -->
    <section class="sec">
      <h2 class="sec-h">Background</h2>
      <div class="tl">
        {timeline.map((t) => (
          <div class="tl-item">
            <div class="tl-aside">
              <div class={`tl-logo${t.emblem ? " emblem" : ""}`}>
                <img src={t.logo} alt={`${t.org} logo`} />
              </div>
              <div class="tl-period">{t.period}</div>
            </div>
            <div class="tl-body">
              <h3 class="tl-org">{t.org}</h3>
              <p class="tl-role">{t.role}</p>
              <p class="tl-phase">{t.phase}</p>
              <p class="tl-did" set:html={t.did} />
              {t.groups.map((g) => (
                <div class="tl-group">
                  {g.label && <p class="tl-group-label">{g.label}</p>}
                  <ul class="tl-qs">
                    {g.questions.map((q) => <li set:html={q} />)}
                  </ul>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ===== playground ===== -->
    <section class="sec play-sec" id="playground">
      <h2 class="sec-h">Playground</h2>
      <p class="block-note play-note">
        Outside the research, I like building small, <em>playable</em> things out of language — a toy
        grammar with its own test suite, a puzzle where you reverse-engineer a language you’ve never
        seen. Same curiosity as the papers, with room to follow a hunch and see what it does.
      </p>
      <div class="play-grid">
        {playground.map((p) => (
          <a class={`play-card play-${p.variant}`} href={p.href} aria-label={`Open ${p.title}`}>
            <div class="play-fig" aria-hidden="true">
              {p.variant === "relay" && (
                <svg class="pr" viewBox="0 0 220 200" role="img" aria-label="The RELAY language machine">
                  <g class="pr-rings">
                    <circle class="pr-ring pr-ring-a" cx="110" cy="100" r="86" />
                    <circle class="pr-ring pr-ring-b" cx="110" cy="100" r="73" />
                  </g>
                  <circle class="pr-disc" cx="110" cy="100" r="66" />
                  <g class="pr-bot">
                    <path class="pr-stalk" d="M64 8v16" />
                    <circle class="pr-bulb" cx="64" cy="8" r="7" />
                    <path class="pr-ear" d="M22 49H12v34h10M106 49h10v34h-10" />
                    <rect class="pr-head" x="20" y="25" width="88" height="86" rx="24" />
                    <rect class="pr-face" x="34" y="42" width="60" height="52" rx="15" />
                    <g class="pr-eyes">
                      <rect class="pr-eye" x="44" y="57" width="16" height="12" />
                      <rect class="pr-eye" x="68" y="57" width="16" height="12" />
                      <rect class="pr-pupil" x="50" y="61" width="6" height="6" />
                      <rect class="pr-pupil" x="72" y="61" width="6" height="6" />
                    </g>
                    <path class="pr-mouth" d="M49 80h30" />
                  </g>
                </svg>
              )}
              {p.variant === "im" && (
                <svg class="pg" viewBox="0 0 220 200" role="img" aria-label="An information state being introduced, linked, and revised">
                  <line class="pg-edge" x1="66" y1="132" x2="156" y2="74" />
                  <circle class="pg-spark" cx="66" cy="132" r="4.5" />
                  <g class="pg-node pg-q">
                    <circle cx="156" cy="74" r="21" />
                    <text x="156" y="75" class="pg-label">q</text>
                  </g>
                  <g class="pg-node pg-p">
                    <circle cx="66" cy="132" r="21" />
                    <text x="66" y="133" class="pg-label">p</text>
                  </g>
                  <g class="pg-revise">
                    <circle class="pg-halo" cx="66" cy="132" r="27" />
                    <text x="95" y="120" class="pg-prime">′</text>
                  </g>
                </svg>
              )}
            </div>
            <div class="play-body">
              <div class="play-top">
                <span class="play-title">{p.title}</span>
                <span class="play-tag">{p.tag}</span>
              </div>
              <p class="play-desc">{p.desc}</p>
              <div class={`play-chips play-chips-${p.variant}`}>
                {p.steps.map((s) => <span class="play-chip">{s}</span>)}
              </div>
              <span class="play-cta">{p.cta}<span class="play-cta-arrow">→</span></span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- ===== contact ===== -->
    <section class="sec">
      <div class="cta">
        <p class="cta-line">Currently applying for PhD positions beginning in fall 2027 — email is the best way to get in touch.</p>
        <p class="cta-links">
          <a href="mailto:xiaochuan.li@utn.de">Email me</a>
          <span class="sep">·</span>
          <a href="/contact">More ways to get in touch</a>
        </p>
      </div>
    </section>
  </div>
</Base>

<style>
  .wrap { max-width: 940px; margin: 0 auto; padding: 2.75rem 1.5rem 5rem; font-family: var(--font-sans); }

  /* ===== header ===== */
  .hd { display: flex; align-items: center; justify-content: space-between; gap: 2.5rem; margin-bottom: 1rem; }
  .hd-photo {
    flex: none;
    width: 208px;
    height: 260px;
    border-radius: 14px;
    border: 1px solid var(--color-border);
    background-color: var(--color-surface-2);
    background-image: url("/images/headshot.jpg");
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }
  .hd-main { min-width: 0; }
  .hd-name { font-family: var(--font-display); font-size: 2.5rem; font-weight: 600; letter-spacing: -0.02em; margin: 0 0 0.6rem; color: var(--color-text); line-height: 1.05; }
  .hd-tag { font-size: 1.15rem; line-height: 1.5; color: var(--color-text); margin: 0 0 0.7rem; max-width: 34rem; }
  .hd-tag :global(strong) { font-weight: 600; }
  .hd-tag :global(em) { font-style: italic; }
  .hd-tag-work { font-size: 1.02rem; color: var(--color-text-muted); margin: 0 0 0.9rem; }
  .hd-tag-work :global(em) { font-style: italic; color: var(--color-text); }
  .hd-affil { font-size: 0.9rem; color: var(--color-text-muted); margin: 0 0 0.8rem; line-height: 1.5; }
  .hd-links { font-family: var(--font-mono); font-size: 0.8rem; letter-spacing: 0.01em; color: var(--color-text-muted); margin: 0; }
  .hd-links a { color: var(--color-accent); text-decoration: none; }
  .hd-links a:hover { text-decoration: underline; }
  .hd-links .sep { color: var(--color-text-ghost); margin: 0 0.45rem; }

  @media (max-width: 620px) {
    .hd { flex-direction: column; align-items: flex-start; gap: 1.4rem; }
    .hd-photo { order: -1; width: 168px; height: 210px; }
    .hd-name { font-size: 2rem; }
    .hd-tag { font-size: 1.05rem; }
  }

  /* ===== research scope ===== */
  .scope { margin-top: 2.6rem; padding: 1.25rem 0 1.35rem; border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); }
  .scope-heading { font-family: var(--font-mono); font-size: 10.5px; font-weight: 500; letter-spacing: 0.2em; text-transform: uppercase; color: var(--color-text-dim); margin: 0 0 1rem; }
  .scope-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem; }
  .scope-item { min-width: 0; }
  .scope-label { font-family: var(--font-mono); font-size: 9.5px; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-accent); margin: 0 0 0.35rem; }
  .scope-title { font-family: var(--font-sans); font-size: 1rem; font-weight: 600; letter-spacing: -0.005em; color: var(--color-text); margin: 0 0 0.35rem; }
  .scope-desc { font-size: 0.88rem; line-height: 1.58; color: var(--color-text-muted); margin: 0; }

  @media (max-width: 680px) {
    .scope-grid { grid-template-columns: 1fr; gap: 1.15rem; }
  }

  /* ===== section frame ===== */
  .sec { margin-top: 3.6rem; }
  .sec-h {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-text-dim);
    margin: 0 0 1.4rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--color-border);
  }
  .sec-h::before { content: "// "; color: var(--color-accent); opacity: 0.6; }

  /* block heading + body (current work, research program) */
  .blk-h { font-family: var(--font-sans); font-size: 1.3rem; font-weight: 600; letter-spacing: -0.01em; color: var(--color-text); margin: 0 0 0.7rem; }
  .blk-h :global(em) { font-style: italic; }
  .blk-body { font-size: 0.98rem; line-height: 1.7; color: var(--color-text-muted); margin: 0 0 0.8rem; max-width: 46rem; }
  .blk-body :global(em) { font-style: italic; color: var(--color-text); }
  .blk-link { margin: 0; font-size: 0.9rem; }
  .blk-link a { color: var(--color-accent); text-decoration: none; }
  .blk-link a:hover { text-decoration: underline; }
  .block-note { font-size: 0.95rem; line-height: 1.65; color: var(--color-text-muted); margin: 0 0 1.4rem; }

  /* ===== timeline ===== */
  .tl { display: flex; flex-direction: column; gap: 2rem; }
  .tl-item { display: grid; grid-template-columns: 150px minmax(0, 1fr); gap: 1.75rem; }
  .tl-aside { display: flex; flex-direction: column; align-items: flex-start; gap: 0.6rem; }
  .tl-logo { min-height: 48px; display: flex; align-items: center; }
  .tl-logo img { height: 36px; width: auto; max-width: 124px; display: block; }
  .tl-logo.emblem img { height: 78px; }
  .tl-period { font-family: var(--font-mono); font-size: 11.5px; letter-spacing: 0.03em; color: var(--color-text-dim); }
  .tl-org { font-family: var(--font-sans); font-size: 1.08rem; font-weight: 600; color: var(--color-text); margin: 0 0 0.15rem; letter-spacing: -0.005em; }
  .tl-role { font-size: 0.92rem; color: var(--color-text-muted); margin: 0 0 0.4rem; }
  .tl-phase { font-family: var(--font-sans); font-size: 0.95rem; font-weight: 600; color: var(--color-accent); margin: 0 0 0.6rem; }
  .tl-did { font-size: 0.95rem; line-height: 1.65; color: var(--color-text-muted); margin: 0 0 0.6rem; }
  .tl-did :global(em) { font-style: italic; }
  .tl-group { margin-top: 0.85rem; }
  .tl-group:first-of-type { margin-top: 0.6rem; }
  .tl-group-label { font-family: var(--font-mono); font-size: 10px; font-weight: 500; letter-spacing: 0.13em; text-transform: uppercase; color: var(--color-text-dim); margin: 0 0 0.4rem; }
  .tl-qs { list-style: none; margin: 0; padding: 0.1rem 0 0.15rem 0.95rem; border-left: 2px solid color-mix(in srgb, var(--color-accent) 30%, transparent); display: flex; flex-direction: column; gap: 0.4rem; }
  .tl-qs li { font-size: 0.92rem; line-height: 1.5; color: var(--color-text-muted); font-style: italic; }
