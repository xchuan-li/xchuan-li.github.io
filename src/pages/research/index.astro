---
import Base from "../../layouts/Base.astro";
import { portfolioSections } from "../../data/portfolio";
import PortfolioEntry from "../../components/PortfolioEntry.astro";
import ModalityChain from "../../components/ModalityChain.astro";
import PaperList from "../../components/PaperList.astro";
---
<Base title="Research & Projects · Xiaochuan Li"
  description="Working papers, manuscripts in preparation, completed research and technical projects, and selected writing by Xiaochuan Li.">
  <article class="work-index">
    <header>
      <p class="eyebrow">Selected work</p>
      <h1>Research & Projects</h1>
      <p class="lede">I study linguistic meaning and inference through formal analysis, human studies,
        and computational methods. My master’s work focuses on modal expressions. Here are the papers,
        projects, and texts that come from that work.</p>
      <nav class="section-index" aria-label="Work categories">
        {portfolioSections.map((section) => <a href={"#" + section.id}>{section.label}</a>)}
      </nav>
    </header>
    {portfolioSections.map((section) => (
      <section class="work-section" id={section.id} aria-labelledby={section.id + "-heading"}>
        <p class="eyebrow">{section.sec}</p>
        <h2 id={section.id + "-heading"}>{section.label}</h2>
        {section.blurb && <p class="section-intro">{section.blurb}</p>}
        {section.id === "current" ? <ModalityChain /> : section.id === "papers" ? <PaperList entries={section.entries} /> : section.entries.map((entry) => <PortfolioEntry entry={entry} />)}
      </section>
    ))}
    <p class="program-link">For the questions connecting these projects, see my <a href="/approach">research program</a>.</p>
  </article>
</Base>
<style>
  .eyebrow { font-family:var(--font-mono); font-size:0.65rem; color:var(--color-text-muted); letter-spacing:0.12em; text-transform:uppercase; margin:0 0 0.5rem; }
  h1 { font-size:clamp(1.8rem,5vw,2.4rem); line-height:1.15; font-weight:600; letter-spacing:-0.02em; margin:0 0 1rem; }
  .lede { font-size:1.07rem; line-height:1.7; color:var(--color-text-muted); margin:0 0 1.6rem; text-wrap:pretty; }
  .section-index { display:flex; flex-wrap:wrap; gap:0.6rem 1.5rem; padding:1rem 0; border-top:1px solid var(--color-border); border-bottom:1px solid var(--color-border); font-size:0.82rem; }
  a { color:var(--color-accent); text-underline-offset:0.2em; }
  a:focus-visible { outline:2px solid var(--color-accent); outline-offset:4px; }
  .work-section { margin-top:3rem; scroll-margin-top:6rem; }
  h2 { font-size:1.6rem; font-weight:600; line-height:1.3; margin:0 0 0.6rem; }
  .section-intro { margin:0 0 1.2rem; color:var(--color-text-muted); line-height:1.6; }
  .program-link { margin-top:2rem; border-top:1px solid var(--color-border); padding-top:1rem; font-size:0.9rem; line-height:1.6; }
</style>
