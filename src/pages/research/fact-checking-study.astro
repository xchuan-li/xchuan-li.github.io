---
import Base from "../../layouts/Base.astro";
import PaperArticle from "../../components/PaperArticle.astro";
import body from "../../content/papers/fact-checking-study.html?raw";
import { projects } from "../../data/projects";
// The write-up as a web page, built from reports/fact-checking/fact-checking.tex by
// reports/web/build_web.py. Group design, class-wide data collection, XC's analysis;
// no classmate names.
---
<Base title={`${projects.psyStudy.title} · Xiaochuan Li`} toc={true}
  description="Does checking with ChatGPT first change how people check and double-check? A complete between-subjects course experiment: design, pilot, revision, data collection (N = 49, 47 analysed) and analysis.">
  <PaperArticle
    back={{ label: "Research & Papers", href: "/research#work-human" }}
    status={projects.psyStudy.status}
    title="Does Checking with ChatGPT First Change How People Check and Double-Check? A Class Experiment"
    authors="Xiaochuan Li"
    affiliation="University of Technology Nuremberg · xiaochuan.li@utn.de"
    date="Written up September 2026 from a course study, Foundations in Psychology and Empirical Study Design, Winter 2025–26"
    body={body}
    pdf="/papers/fact-checking-study.pdf" />
</Base>
