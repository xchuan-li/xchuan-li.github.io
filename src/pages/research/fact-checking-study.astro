---
import Base from "../../layouts/Base.astro";
import PdfReport from "../../components/PdfReport.astro";
import { projects } from "../../data/projects";
// Full write-up (reports/fact-checking/, tectonic), 28 Sep 2026. Sources: the group
// protocol (Assignment 7 and its revision), the pilot table, and XC's own analysis
// (Assignment 10). Group design, class-wide data collection, XC's analysis; the Welch
// tests are computed from summary statistics for the write-up. No classmate names.
const p = projects.psyStudy;
---
<Base title={`${p.title} · Xiaochuan Li`}
  description="Does checking with ChatGPT first change how people check and double-check? A between-subjects course experiment (N = 47 analysed), written up with design, pilot revisions, results, and limits.">
  <PdfReport
    back={{ label: "Course projects", href: "/research#projects" }}
    status={p.status}
    title="Does Checking with ChatGPT First Change How People Check and Double-Check?"
    meta="Xiaochuan Li · written up September 2026 from a course study (Foundations in Psychology and Empirical Study Design, Winter 2025–26). Designed with two classmates and run by the class; I analysed the data."
    pdf="/papers/fact-checking-study.pdf"
    preview="/papers/fact-checking-study.png" />
</Base>
