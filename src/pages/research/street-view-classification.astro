---
import Base from "../../layouts/Base.astro";
import PdfReport from "../../components/PdfReport.astro";
import { projects } from "../../data/projects";
// Full write-up (reports/street-view/, compiled with tectonic), replacing the short
// description on 28 Sep 2026. Numbers from the project record; no new runs.
---
<Base title={`${projects.streetView.title} · Xiaochuan Li`}
  description="Training choices in a small CNN for 18-country street-image classification: a written-up course project with 17 single-seed runs, from 0.619 to 0.823 validation accuracy.">
  <PdfReport
    back={{ label: "Course projects", href: "/research#projects" }}
    status={projects.streetView.status}
    title="Training Choices in a Small CNN for Street-View Country Classification"
    meta="Xiaochuan Li · written up September 2026 from a three-person course project (Deep Learning, Summer 2026). I trained the models and ran and analysed the experiments; a teammate implemented the training pipeline."
    pdf="/papers/street-view-classification.pdf"
    preview="/papers/street-view-classification.png" />
</Base>
