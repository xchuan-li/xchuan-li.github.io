---
import Base from "../../layouts/Base.astro";
import PaperArticle from "../../components/PaperArticle.astro";
import body from "../../content/papers/street-view-classification.html?raw";
import { projects } from "../../data/projects";
// The write-up as a web page, built from reports/street-view/street-view.tex by
// reports/web/build_web.py (run it after editing the paper). The PDF is the same text.
---
<Base title={`${projects.streetView.title} · Xiaochuan Li`} toc={true}
  description="Training choices in a small CNN for 18-country street-image classification: 17 single-seed runs from 0.619 to 0.823 validation accuracy, and what the comparisons showed.">
  <PaperArticle
    status={projects.streetView.status}
    title="Training Choices in a Small CNN for Street-View Country Classification"
    authors="Xiaochuan Li"
    affiliation="University of Technology Nuremberg · xiaochuan.li@utn.de"
    date="Written up September 2026 from a team course project, Deep Learning, Summer 2026"
    body={body}
    pdf="/papers/street-view-classification.pdf" />
</Base>
