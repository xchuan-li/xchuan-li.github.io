---
import Base from "../../layouts/Base.astro";
import PdfReport from "../../components/PdfReport.astro";
import { projects } from "../../data/projects";
// Since 28 Sep 2026 the page is the full single-author course paper (final version of
// 30 Jul 2026, corrected re-run, 12,596 judgments). The earlier web report with timeline
// and demo is kept in git history; report-1 remains at its own URL.
---
<Base title={`${projects.protobias.title} · Xiaochuan Li`}
  description="Cross-lingual prototypicality bias in multimodal evaluation metrics and VLM judges: a single-author course paper with fixed image pairs, seven languages, and two VLM families.">
  <PdfReport
    back={{ label: "Course projects", href: "/research#projects" }}
    status={projects.protobias.status}
    title="Cross-Lingual Prototypicality Bias in Multimodal Evaluation Metrics and VLM Judges"
    meta="Xiaochuan Li · single-author course paper, University of Technology Nuremberg, July 2026"
    pdf="/papers/cross-lingual-protobias.pdf"
    preview="/papers/cross-lingual-protobias.png"
    links={[{ label: "Code & data ↗", href: "https://github.com/xchuan-li/cross_lingual_protobias" }]} />
</Base>
