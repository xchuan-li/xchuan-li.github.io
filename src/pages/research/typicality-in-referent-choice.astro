    pdf="/papers/typicality-in-referent-choice.pdf"
    links={[
      { label: "LingBuzz ↗", href: "https://lingbuzz.net/lingbuzz/010343" },
      { label: "DOI ↗", href: "https://doi.org/10.5281/zenodo.22855036" },
