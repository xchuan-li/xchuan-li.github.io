---
// Papers & Writing Samples as a plain list (XC, 27 September 2026): one line per item,
// in the form other early-career sites use — "Kind year: Title — link · link".
import type { PortfolioEntry } from "../data/portfolio";
interface Props { entries: PortfolioEntry[]; }
const { entries } = Astro.props;
---
<ul class="plist">
  {entries.map((e) => (
    <li>
      <span class="plist-kind">{e.kind ?? e.status}:</span>
      <a class="plist-title" href={e.links[0].href}>{e.title}</a>
      <span class="plist-links">{" — "}{e.links.map((l, i) => <>{i > 0 && " · "}<a href={l.href}>{l.label}</a></>)}</span>
      {e.sample && <span class="plist-ws">writing sample</span>}
    </li>
  ))}
</ul>

<style>
  .plist { list-style:none; margin:0; padding:0.7rem 0 0; border-top:1px solid var(--color-border); display:grid; gap:0.35rem; }
  li { font-size:0.96rem; line-height:1.55; color:var(--color-text-muted); text-wrap:pretty; }
  .plist-kind { font-weight:600; color:var(--color-text); }
  .plist-title { font-style:italic; color:var(--color-text); text-decoration:none; }
  .plist-title:hover { color:var(--color-accent); text-decoration:underline; text-underline-offset:0.15em; }
  .plist-links a { color:var(--color-accent); }
  .plist-links a:hover { text-underline-offset:0.2em; }
  .plist-ws { margin-left:0.5rem; font:0.68rem/1 var(--font-mono); letter-spacing:0.04em; color:var(--color-text-dim); white-space:nowrap; }
  a:focus-visible { outline:2px solid var(--color-accent); outline-offset:3px; }
</style>
