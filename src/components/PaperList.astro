---
// Research & Papers (XC, 29 Sep 2026). Three tabs named by XC; the tab shows the short
// name, the open panel shows the full heading and its subtitle. Each item: type label
// on the left, then status line, title, one sentence, links, and a first-page thumbnail
// when a public text exists. No spine (XC): the items are independent projects.
// Without JavaScript all three lists show one after another. #work-<track> opens a tab.
import { paperTracks, type PortfolioEntry } from "../data/portfolio";
interface Props { entries: PortfolioEntry[]; }
const { entries } = Astro.props;
const groups = paperTracks
  .map((t) => ({ ...t, items: entries.filter((e) => e.track === t.id) }))
  .filter((g) => g.items.length > 0);
---
<div class="ptabs" data-ptabs>
  <div class="ptab-bar" role="tablist" aria-label="Work by field" hidden data-ptab-bar>
    {groups.map((g, i) => (
      <button type="button" role="tab" id={"ptab-" + g.id} aria-controls={"work-" + g.id}
        aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1} data-ptab={g.id}>
        {g.label}
      </button>
    ))}
  </div>
  {groups.map((g) => (
    <div class="ptab-panel" id={"work-" + g.id} role="tabpanel" aria-labelledby={"ptab-" + g.id} data-ppanel={g.id}>
      <header class="ptab-head">
        <h3>{g.title}</h3>
        <p>{g.sub}</p>
      </header>
      <ol class="chain">
        {g.items.map((e) => {
          const href = e.links[0]?.href;
          return (
            <li class="step">
              <p class="topic">{e.topic}</p>
              <div class="body">
                <p class="meta">{e.kind ?? e.status}</p>
                <h4>{href ? <a href={href}>{e.title}</a> : e.title}</h4>
                <p class="short">{e.short ?? e.desc}</p>
                {e.links.length > 1 && <p class="links">{e.links.slice(1).map((l, i) => <>{i > 0 && <span class="sep" aria-hidden="true">·</span>}<a href={l.href}>{l.label}</a></>)}</p>}
              </div>
              {e.thumb && href && <a class="thumb" href={href} tabindex="-1" aria-hidden="true"><img src={e.thumb} alt="" width="300" height="424" loading="lazy" decoding="async" /></a>}
            </li>
          );
        })}
      </ol>
    </div>
  ))}
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-ptabs]").forEach((root) => {
    const bar = root.querySelector<HTMLElement>("[data-ptab-bar]");
    const tabs = [...root.querySelectorAll<HTMLButtonElement>("[data-ptab]")];
    const panels = [...root.querySelectorAll<HTMLElement>("[data-ppanel]")];
    if (!bar || !tabs.length) return;
    root.classList.add("is-tabbed");
    bar.hidden = false;
    const select = (id: string, focus = false) => {
      tabs.forEach((t) => {
        const on = t.dataset.ptab === id;
        t.setAttribute("aria-selected", String(on));
        t.tabIndex = on ? 0 : -1;
        if (on && focus) t.focus();
      });
      panels.forEach((p) => { p.hidden = p.dataset.ppanel !== id; });
    };
    const fromHash = () => {
      const id = location.hash.replace(/^#work-/, "");
      if (location.hash.startsWith("#work-") && tabs.some((t) => t.dataset.ptab === id)) {
        select(id);
        // Instant, and after load: the page's smooth scrolling is otherwise cut short.
        const go = () => requestAnimationFrame(() => root.closest("section")?.scrollIntoView({ behavior: "instant" }));
        document.readyState === "complete" ? go() : window.addEventListener("load", go, { once: true });
      }
    };
    select(tabs[0].dataset.ptab!);
    fromHash();
    window.addEventListener("hashchange", fromHash);
    tabs.forEach((t, i) => {
      t.addEventListener("click", () => {
        select(t.dataset.ptab!);
        history.replaceState(null, "", "#work-" + t.dataset.ptab);
      });
      t.addEventListener("keydown", (ev) => {
        const step = ev.key === "ArrowRight" ? 1 : ev.key === "ArrowLeft" ? -1 : 0;
        const to = ev.key === "Home" ? 0 : ev.key === "End" ? tabs.length - 1 : step ? (i + step + tabs.length) % tabs.length : -1;
        if (to < 0) return;
        ev.preventDefault();
        select(tabs[to].dataset.ptab!, true);
        history.replaceState(null, "", "#work-" + tabs[to].dataset.ptab);
      });
    });
  });
</script>

<style>
  .ptab-bar { display:grid; grid-template-columns:repeat(3, minmax(0,1fr)); border:1px solid var(--color-border-strong); margin:0 0 1.4rem; }
  .ptab-bar[hidden] { display:none; }
  .ptab-bar button { appearance:none; margin:0; padding:0.7rem 0.5rem; border:0; border-left:1px solid var(--color-border-strong); background:transparent; color:var(--color-text-muted); font:0.7rem/1.3 var(--font-mono); letter-spacing:0.07em; text-transform:uppercase; cursor:pointer; transition:background-color .15s, color .15s; }
  .ptab-bar button:first-child { border-left:0; }
  .ptab-bar button:hover { background:var(--color-surface); color:var(--color-text); }
  .ptab-bar button[aria-selected="true"] { background:var(--color-text); color:var(--color-bg); }
  .ptab-bar button:focus-visible { outline:2px solid var(--color-accent); outline-offset:2px; position:relative; z-index:1; }

  .ptab-panel + .ptab-panel { margin-top:2.2rem; }
  .ptab-head { margin:0 0 0.9rem; }
  .ptab-head h3 { margin:0; font-family:var(--font-serif); font-size:1.2rem; font-weight:600; line-height:1.35; color:var(--color-text); text-wrap:balance; }
  .ptab-head p { margin:0.15rem 0 0; font-family:var(--font-serif); font-style:italic; font-size:0.95rem; line-height:1.5; color:var(--color-text-muted); }

  /* Columns: type label | body | thumbnail. Each item is ruled off on its own. */
  .chain { --q:140px; --gap:1.75rem; list-style:none; margin:0; padding:0; border-top:1px solid var(--color-border); }
  .step { display:grid; grid-template-columns:var(--q) minmax(0,1fr) auto; column-gap:var(--gap); padding:0.95rem 0 1rem; border-bottom:1px solid var(--color-border); }
  .topic { margin:0.05rem 0 0; font-family:var(--font-serif); font-size:0.98rem; line-height:1.4; color:var(--color-text); text-wrap:balance; }
  .body { min-width:0; }
  .meta { margin:0 0 0.45rem; font:0.65rem/1.6 var(--font-mono); letter-spacing:0.04em; color:var(--color-text-muted); }
  h4 { margin:0 0 0.3rem; font-family:var(--font-serif); font-size:1.08rem; font-weight:600; line-height:1.35; color:var(--color-text); text-wrap:pretty; }
  h4 a { color:var(--color-text); text-decoration:none; }
  h4 a::after { content:" →"; color:var(--color-accent); font-weight:400; }
  h4 a:hover { color:var(--color-accent); text-decoration:underline; text-underline-offset:0.15em; }
  .short { margin:0; font-size:0.93rem; line-height:1.55; color:var(--color-text-muted); text-wrap:pretty; }
  .links { margin:0.4rem 0 0; font:0.72rem/1.6 var(--font-mono); }
  .links a { color:var(--color-accent); text-decoration:none; }
  .links a:hover { text-decoration:underline; text-underline-offset:0.2em; }
  .sep { color:var(--color-text-ghost); margin:0 0.45rem; }
  .thumb { display:block; width:56px; aspect-ratio:1 / 1.414; margin-top:0.2rem; border:1px solid var(--color-border-strong); background:#fff; overflow:hidden; }
  .thumb img { display:block; width:100%; height:100%; object-fit:cover; object-position:top; transition:opacity .15s; }
  .thumb:hover img { opacity:.8; }
  a:focus-visible { outline:2px solid var(--color-accent); outline-offset:3px; }

  @media (max-width:620px) {
    .chain { --gap:1rem; }
    .step { grid-template-columns:minmax(0,1fr) auto; }
    .topic { grid-column:1; font-style:italic; margin-bottom:0.35rem; }
    .body { grid-column:1; }
    .thumb { grid-column:2; grid-row:1 / span 2; width:44px; }
    .ptab-bar button { padding:0.65rem 0.25rem; font-size:0.6rem; letter-spacing:0.03em; }
  }
</style>
