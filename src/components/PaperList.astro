---
// Papers & Reports (XC, 28 Sep 2026): each item is a first-page thumbnail, the title,
// a meta line, one sentence on what it finds or argues, and links. Work without a
// public PDF gets a small "in preparation" placeholder instead of a thumbnail.
import type { PortfolioEntry } from "../data/portfolio";
interface Props { entries: PortfolioEntry[]; }
const { entries } = Astro.props;
---
<ol class="plist">
  {entries.map((e) => (
    <li class="pl">
      {e.thumb
        ? <a class="pl-thumb" href={e.links[0].href} tabindex="-1" aria-hidden="true"><img src={e.thumb} alt="" width="300" height="424" loading="lazy" decoding="async" /></a>
        : <span class="pl-thumb pl-none" aria-hidden="true">in<br />prep.</span>}
      <div class="pl-body">
        <h3><a href={e.links[0].href}>{e.title}</a></h3>
        <p class="pl-meta">{e.kind ?? e.status}{e.sample && <span class="pl-ws">writing sample</span>}</p>
        <p class="pl-short">{e.short ?? e.desc}</p>
        <p class="pl-links">{e.links.map((l, i) => <>{i > 0 && <span class="sep" aria-hidden="true">·</span>}<a href={l.href}>{l.label}</a></>)}</p>
      </div>
    </li>
  ))}
</ol>

<style>
  .plist { list-style:none; margin:0; padding:0; border-top:1px solid var(--color-border); }
  .pl { display:grid; grid-template-columns:74px minmax(0,1fr); column-gap:1.25rem; padding:1.05rem 0; border-bottom:1px solid var(--color-border); }
  .pl-thumb { display:block; width:74px; aspect-ratio:1 / 1.414; border:1px solid var(--color-border-strong); background:#fff; overflow:hidden; }
  .pl-thumb img { display:block; width:100%; height:100%; object-fit:cover; object-position:top; transition:opacity .15s; }
  a.pl-thumb:hover img { opacity:.8; }
  .pl-none { display:flex; align-items:center; justify-content:center; text-align:center; background:var(--color-surface); border-style:dashed; font:0.55rem/1.3 var(--font-mono); letter-spacing:0.06em; text-transform:uppercase; color:var(--color-text-dim); }
  .pl-body { min-width:0; }
  h3 { margin:0 0 0.3rem; font-family:var(--font-serif); font-size:1.05rem; font-weight:600; line-height:1.35; text-wrap:pretty; }
  h3 a { color:var(--color-text); text-decoration:none; }
  h3 a:hover { color:var(--color-accent); text-decoration:underline; text-underline-offset:0.15em; }
  .pl-meta { margin:0 0 0.4rem; font:0.66rem/1.5 var(--font-mono); letter-spacing:0.05em; text-transform:uppercase; color:var(--color-text-muted); }
  .pl-ws { margin-left:0.7rem; padding:0 0.35rem; border:1px solid var(--color-border-strong); text-transform:none; letter-spacing:0.02em; color:var(--color-text-dim); }
  .pl-short { margin:0 0 0.45rem; font-size:0.93rem; line-height:1.6; color:var(--color-text-muted); text-wrap:pretty; }
  .pl-links { margin:0; font:0.74rem/1.6 var(--font-mono); }
  .pl-links a { color:var(--color-accent); text-decoration:none; }
  .pl-links a:hover { text-decoration:underline; text-underline-offset:0.2em; }
  .sep { color:var(--color-text-ghost); margin:0 0.5rem; }
  a:focus-visible { outline:2px solid var(--color-accent); outline-offset:3px; }
  @media (max-width:560px) {
    .pl { grid-template-columns:56px minmax(0,1fr); column-gap:0.9rem; }
    .pl-thumb { width:56px; }
  }
</style>
