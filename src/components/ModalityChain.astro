---
// The modality section as one chain (XC, 27 September 2026): the left column names the
// question each project answers, a hairline spine joins them, and a return line closes
// the loop. It shows one analysis tested by two separate studies, not "one theory, two
// systems" (CONTEXT red line 1). Status lines say what exists, not only what is missing.
import { projects } from "../data/projects";

const steps = [
  {
    question: "What does it contribute?",
    project: projects.threeWays,
    status: "Formal analysis · draft derivations; independent judgments pending",
    link: "Question & diagnostics",
  },
  {
    question: "Do children understand it?",
    project: projects.thesis,
    status: "Master’s thesis · contrast being agreed; no data yet",
    link: "Thesis outline",
  },
  {
    question: "Can it be learned from input alone?",
    project: projects.modalModels,
    status: "Model study · diagnostic runs; controlled training planned",
    link: "Project outline",
  },
];
---
<ol class="chain">
  {steps.map((s) => (
    <li class="chain-step">
      <p class="chain-q">{s.question}</p>
      <span class="chain-node" aria-hidden="true"></span>
      <div class="chain-body">
        <p class="chain-status">{s.status}</p>
        <h3><a href={s.project.href}>{s.project.title}</a></h3>
        <p class="chain-desc">{s.project.summary}</p>
        <p class="chain-link"><a href={s.project.href}>{s.link} <span aria-hidden="true">→</span></a></p>
      </div>
    </li>
  ))}
</ol>
<p class="chain-return"><span class="chain-loop" aria-hidden="true">↺</span><span>Where children or models depart from the predictions, the analysis is revised.</span></p>

<style>
  /* Columns match PortfolioEntry (140px | gap 1.75rem | body); the spine sits in the gap. */
  .chain { --q:140px; --gap:1.75rem; --spine:calc(var(--q) + var(--gap) / 2); list-style:none; margin:0; padding:0; border-top:1px solid var(--color-border); }
  .chain-step { position:relative; display:grid; grid-template-columns:var(--q) minmax(0,1fr); column-gap:var(--gap); padding:1.35rem 0 1.4rem; }
  .chain-step::before { content:""; position:absolute; top:0; bottom:0; left:var(--spine); border-left:1px solid var(--color-text); }
  .chain-step:first-child::before { top:1.85rem; }
  .chain-node { position:absolute; left:calc(var(--spine) - 3px); top:calc(1.35rem + 0.42rem); width:7px; height:7px; background:var(--color-text); }
  .chain-q { margin:0.05rem 0 0; font-family:var(--font-serif); font-size:0.98rem; line-height:1.4; color:var(--color-text); text-wrap:balance; }
  .chain-body { min-width:0; }
  .chain-status { font-family:var(--font-mono); font-size:0.65rem; line-height:1.6; letter-spacing:0.04em; color:var(--color-text-muted); margin:0 0 0.45rem; }
  h3 { margin:0 0 0.55rem; font-family:var(--font-serif); font-size:1.25rem; font-weight:600; line-height:1.3; text-wrap:pretty; }
  h3 a { color:var(--color-text); text-decoration:none; }
  h3 a:hover { color:var(--color-accent); text-decoration:underline; text-underline-offset:0.15em; }
  .chain-desc { font-size:0.96rem; line-height:1.65; color:var(--color-text-muted); margin:0 0 0.6rem; text-wrap:pretty; }
  .chain-link { margin:0; font-size:0.86rem; }
  .chain-link a { color:var(--color-accent); text-decoration:underline; text-decoration-color:var(--color-border-strong); text-underline-offset:0.22em; }
  a:focus-visible { outline:2px solid var(--color-accent); outline-offset:4px; }
  .chain-return { --q:140px; --gap:1.75rem; position:relative; display:grid; grid-template-columns:var(--q) minmax(0,1fr); column-gap:var(--gap); margin:0; padding:0.2rem 0 0; font-size:0.92rem; line-height:1.55; color:var(--color-text); }
  .chain-loop { position:absolute; left:calc(var(--q) + var(--gap) / 2); top:0.25rem; transform:translateX(-50%); font-family:var(--font-mono); font-size:1rem; line-height:1.4; }
  .chain-return > span:not(.chain-loop) { grid-column:2; }
  @media (max-width:620px) {
    .chain, .chain-return { --q:0px; --gap:1.6rem; }
    .chain-step, .chain-return { grid-template-columns:0 minmax(0,1fr); }
    .chain-q { grid-column:2; font-style:italic; margin-bottom:0.5rem; }
    .chain-body { grid-column:2; }
  }
</style>
