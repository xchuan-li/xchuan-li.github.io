---
// Homepage Fig. 1, possibility space (2026-09-23; replaces MappingFigure). The square is everything "animal" allows: a solid
// field of its letters, with the kinds it could pick out written in darker capitals, each covering its share,
// typicality first, then the context. Ink is whether a kind has been said: "might" turns insect black, its
// area unchanged. Plays on a loop; a pause button stops it, and reduced motion shows the last state.
// Drawing: src/scripts/space-figure.js.
const caption =
  'How far the description goes, and what typicality adds: <a href="/research/typicality-in-referent-choice"><i>Typicality in referent choice</i></a>. What <i>might</i> and <i>I don’t know whether</i> leave open: <a href="/research/three-ways"><i>Three Ways of Leaving p Unsettled</i></a>.';
---

<figure class="mapfig" data-space aria-labelledby="mapfig-caption">
  <div class="mapfig-screen">
    <div class="mapfig-hud">
      <span>Fig. 1 · what <i>animal</i> leaves open</span>
      <span class="mapfig-keys">
        <button type="button" data-pause aria-pressed="false" aria-label="Pause">❚❚</button>
      </span>
    </div>
    <canvas data-field aria-hidden="true"></canvas>
  </div>
  <p class="sr-only">
    An animated diagram on a loop. A square stands for everything the word animal allows. It is filled with the letters
    of animal, and eight kinds are written into it in darker capitals: bird, dog, cat, monkey, pig, insect, cow and fish.
    Each kind’s area is how readily it comes to mind; after “animal”, dog, bird and monkey take the most space and insect
    little. When “in the tree” is added, every word stays where it is: dog shrinks sharply, bird and monkey grow a little,
    insect grows. Then “it might be an insect” is added, and the insect’s name turns black while its area stays the same.
  </p>
  <p class="mapfig-legend">
    the square: everything <i>animal</i> allows, written in its letters · area: how available each kind is ·
    grey: unsaid · black: said
  </p>
  <figcaption id="mapfig-caption"><b>Fig. 1</b><Fragment set:html={caption} /></figcaption>
</figure>

<script>
  import "../scripts/space-figure.js";
</script>

<style is:global>
  .mapfig { margin: 2rem 0 0; }
  .mapfig-screen {
    position: relative;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: 0.75rem 1rem;
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.4;
    color: var(--color-text);
    /* canvas ink, as "r,g,b" */
    --ink-strong: 22, 24, 29;
    --ink-said: 216, 90, 48;
  }
  .mapfig-hud { display: flex; justify-content: space-between; align-items: center; gap: 0.75rem; color: var(--color-text-dim); font-size: 10.5px; letter-spacing: 0.14em; text-transform: uppercase; }
  .mapfig-keys { display: flex; gap: 4px; }
  .mapfig-keys button { font: 10.5px var(--font-mono); color: var(--color-text-muted); background: transparent; border: 1px solid var(--color-border); padding: 2px 7px; cursor: pointer; letter-spacing: 0; }
  .mapfig-keys button:hover { color: var(--color-text); border-color: var(--color-border-strong); }
  .mapfig-keys button[aria-pressed="true"] { color: #fff; background: var(--color-text); border-color: var(--color-text); }
  .mapfig-keys button:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }
  .mapfig canvas { display: block; width: 100%; margin: 0.75rem 0 0.5rem; }
  .mapfig-legend { font-family: var(--font-mono); font-size: 11px; line-height: 1.6; color: var(--color-text-dim); margin: 0.6rem 0 0; }
  .mapfig figcaption { font-size: 0.88rem; line-height: 1.55; color: var(--color-text-muted); margin-top: 0.5rem; }
  .mapfig figcaption b { font-family: var(--font-mono); font-weight: 500; font-size: 0.75rem; color: var(--color-text); margin-right: 0.4rem; }
  .mapfig figcaption a { color: var(--color-accent); }
  @media (max-width: 600px) {
    .mapfig-screen { padding: 0.6rem 0.75rem; }
    .mapfig-hud { flex-wrap: wrap; }
  }
</style>
