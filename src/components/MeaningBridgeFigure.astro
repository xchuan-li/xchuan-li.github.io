---
// Homepage Fig. 1 (XC, 1 Oct 2026). Replaces the four-beat version generated by
// design-demos/meaning-bridge/gen_b.py, whose chart, blackboard and model answers
// read as results. Two things were tried and dropped (XC): a middle panel holding
// the account — method, not the claim, and unreadable unlabelled — and must/might
// in the middle, which named the stimulus rather than the object of study. What is
// left: one straight line from people through language to language models, and the
// one asymmetry that matters — the model can be opened and the person cannot.
// Hand-drawn style after Jason Windsor, "The End of the World" (2003).
// Hand-written from here on; gen_b.py is kept only as the record of draft B.
---
<figure class="mbfig" aria-label="Figure 1">
  <svg viewBox="0 0 800 280" role="img"
       aria-label="A person on the left and a language model on the right, joined by one straight line through a box that reads: language. The model's casing is open, showing nodes inside; the person cannot be opened.">
    <defs>
      <filter id="mb-boil" x="-5%" y="-5%" width="110%" height="110%">
        <feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="2" seed="1" result="n">
          <animate attributeName="seed" values="1;4;8" dur="1.2s" calcMode="discrete" repeatCount="indefinite"/>
        </feTurbulence>
        <feDisplacementMap in="SourceGraphic" in2="n" scale="2.2"/>
      </filter>
    </defs>

    <g filter="url(#mb-boil)" stroke="#141414" stroke-width="3.2" stroke-linejoin="round" stroke-linecap="round">
      <path d="M8 7 L793 4 L795 274 L5 276 Z" fill="#fff"/>

      <!-- one line, left to right, through the thing being studied -->
      <path d="M212 150 L306 150 M496 150 L590 150" fill="none" stroke-width="2.4"/>
      <path d="M306 115 L494 112 L496 184 L308 187 Z" fill="#fdfbf4" stroke-width="2.8"/>
      <text class="w" x="401" y="161" text-anchor="middle">language</text>

      <!-- person: no way in -->
      <g transform="translate(63,-126) scale(0.8)">
        <circle cx="150" cy="300" r="21" fill="#f2cfa4"/>
        <path d="M131 292 L136 276 L144 288 L150 272 L156 288 L165 276 L169 292" fill="#e8b33c" stroke-width="2.4"/>
        <circle cx="143" cy="301" r="2.4" fill="#141414" stroke="none"/><circle cx="157" cy="301" r="2.4" fill="#141414" stroke="none"/>
        <path d="M143 311 Q150 316 157 310" fill="none" stroke-width="2.2"/>
        <path d="M131 322 L169 320 L174 378 L127 380 Z" fill="#e2574c"/>
        <path d="M140 380 L136 426 M162 379 L167 426" fill="none" stroke-width="4"/>
        <path d="M131 330 L114 364 M169 330 L186 364" fill="none" stroke-width="4"/>
      </g>

      <!-- language model: the casing is open -->
      <g transform="translate(168.4,-99) scale(0.72)">
        <path d="M631 290 L631 276" fill="none"/><circle cx="631" cy="271" r="5" fill="#e03a2f"/>
        <path d="M600 292 L664 290 L666 338 L598 340 Z" fill="#b9bec4"/>
        <path d="M612 306 L622 306 L622 316 L612 316 Z M640 306 L650 306 L650 316 L640 316 Z" fill="#141414"/>
        <path d="M614 328 L648 327" fill="none" stroke-width="2.4"/>
        <path d="M588 340 L676 338 L678 412 L586 414 Z" fill="#b9bec4"/>
        <path d="M604 355 L633 380 L658 355 M604 355 L611 397 L633 380 L658 398" fill="none" stroke-width="2.4"/>
        <g fill="#fff" stroke-width="2.4">
          <circle cx="604" cy="355" r="6"/><circle cx="658" cy="355" r="6"/>
          <circle cx="633" cy="380" r="6"/><circle cx="611" cy="397" r="6"/><circle cx="658" cy="398" r="6"/>
        </g>
        <path d="M678 338 L722 326 L724 402 L678 412 Z" fill="#9aa0a6" stroke-width="2.6"/>
        <path d="M612 414 L610 436 M652 413 L654 436" fill="none" stroke-width="4"/>
      </g>

      <g stroke="none">
        <text class="lbl" x="183" y="252" text-anchor="middle">people</text>
        <text class="lbl" x="652" y="252" text-anchor="middle">language models</text>
      </g>
    </g>
  </svg>
  <figcaption>
    <span class="fnum">Fig. 1</span>
    Language as it is used by two kinds of language user — only one of which can be opened.
    Illustration, not results. See the <a href="/approach">research program</a>.
  </figcaption>
</figure>

<style>
  .mbfig { margin:1.6rem auto 0; max-width:580px; }
  svg { display:block; width:100%; height:auto; }
  svg text { font-family:"Patrick Hand", "Comic Sans MS", cursive; fill:#141414; }
  .lbl { font-size:19px; }
  .w { font-size:23px; letter-spacing:0.01em; }

  figcaption { margin:0.7rem 0 0; font-size:0.82rem; line-height:1.6; color:var(--color-text-muted); }
  .fnum { font-family:var(--font-mono); font-size:0.72rem; letter-spacing:0.06em; color:var(--color-text); margin-right:0.5rem; }
  figcaption a { color:var(--color-accent); }
</style>
