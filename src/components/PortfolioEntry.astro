---
import type { PortfolioEntry } from "../data/portfolio";
interface Props { entry: PortfolioEntry; }
const { entry } = Astro.props;
---
<article class="work-entry">
  <div class="work-aside">
    <p class="work-field">{entry.field}</p>
    {entry.note && <aside class="work-note">
      <p class="work-note-label">{entry.note.label}</p>
      <p>{entry.note.text}</p>
    </aside>}
  </div>
  <div class="work-copy">
    <p class="work-status">{entry.status}</p>
    <h3><a href={entry.links[0].href}>{entry.title}</a></h3>
    <div class:list={["work-body", { "with-cover": entry.cover }]}>
      <div>
        <p class="work-desc">{entry.desc}</p>
        <ul class="work-links" aria-label={entry.title + " resources"}>
          {entry.links.map((link) => <li><a href={link.href}>{link.label} <span aria-hidden="true">→</span></a></li>)}
        </ul>
      </div>
      {entry.cover && <a class="work-cover" href={entry.links[0].href} aria-label={"Open " + entry.title}>
        <img src={entry.cover.src} alt={entry.cover.alt} width="1200" height="720" loading="lazy" decoding="async" />
      </a>}
    </div>
  </div>
</article>

<style>
  .work-entry { display:grid; grid-template-columns:140px minmax(0,1fr); gap:1.75rem; padding:1.35rem 0 1.5rem; border-top:1px solid var(--color-border); }
  .work-copy { min-width:0; }
  .work-field { margin:0.1rem 0 0; font-size:0.8rem; line-height:1.55; color:var(--color-accent); }
  .work-status { font-family:var(--font-mono); font-size:0.65rem; line-height:1.6; letter-spacing:0.04em; color:var(--color-text-muted); margin:0 0 0.5rem; }
  h3 { margin:0 0 0.65rem; font-family:var(--font-serif); font-size:1.25rem; font-weight:600; line-height:1.3; text-wrap:pretty; }
  h3 a { color:var(--color-text); text-decoration:none; }
  h3 a:hover { color:var(--color-accent); text-decoration:underline; text-underline-offset:0.15em; }
  .work-desc { font-size:0.96rem; line-height:1.65; color:var(--color-text-muted); margin:0 0 0.8rem; text-wrap:pretty; }
  .with-cover { display:grid; grid-template-columns:minmax(0,1fr) 180px; gap:1.3rem; align-items:start; }
  .work-cover { display:block; }
  .work-cover img { display:block; width:100%; height:auto; }
  .work-links { list-style:none; margin:0; padding:0; display:flex; flex-wrap:wrap; gap:0.4rem 1.3rem; font-size:0.86rem; }
  .work-links a { color:var(--color-accent); text-decoration:underline; text-decoration-color:var(--color-border-strong); text-underline-offset:0.22em; }
  a:focus-visible { outline:2px solid var(--color-accent); outline-offset:4px; }
  .work-note { margin-top:0.85rem; padding-left:0.7rem; border-left:1px solid var(--color-border-strong); font-size:0.76rem; line-height:1.6; color:var(--color-text-muted); }
  .work-note p { margin:0; }
  .work-note .work-note-label { font-family:var(--font-mono); font-size:0.6rem; text-transform:uppercase; letter-spacing:0.1em; margin-bottom:0.35rem; }
  @media (max-width:900px) { .with-cover { grid-template-columns:1fr; } .work-cover { max-width:240px; } }
  @media (max-width:620px) {
    .work-entry { grid-template-columns:1fr; gap:0.65rem; }
    .work-aside { display:contents; }
    .work-field { order:0; }
    .work-copy { order:1; }
    .work-note { order:2; margin-top:0; }
  }
</style>
