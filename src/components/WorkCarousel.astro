---
// Earlier work on the homepage as a carousel, one project at a time with its poster
// (XC, 26 Oct 2026: "左右滚动切换，这样一次就只展示一个，图就可以大一点"). Each slide is the poster
// and one grey line under it; the poster carries the title and summary ("图片在前面，下面一行灰色的字简单概括").
// Slides advance every `interval` ms and wrap round; hovering or focusing pauses, and
// reduced-motion users get no autoplay. Without JavaScript the track still scrolls sideways.
import type { PortfolioEntry } from "../data/portfolio";
interface Props { entries: PortfolioEntry[]; label: string; interval?: number; }
const { entries, label, interval = 7000 } = Astro.props;
---
<div class="carousel" data-carousel data-interval={interval} role="region" aria-roledescription="carousel" aria-label={label}>
  <div class="track" data-track>
    {entries.map((e, i) => {
      const href = e.links[0]?.href;
      return (
        <article class="slide" aria-roledescription="slide" aria-label={`${i + 1} of ${entries.length}: ${e.title}`}>
          {e.poster && <a class="poster" href={href ?? e.poster.pdf}>
            <img src={e.poster.src} alt={e.poster.alt} width={e.poster.width} height={e.poster.height} loading="lazy" decoding="async" />
          </a>}
          <p class="line">{e.poster?.line ?? e.short ?? e.desc}
            <span class="links">{e.links.map((l, k) => <>{k > 0 && <span class="sep" aria-hidden="true">·</span>}<a href={l.href}>{l.label}</a></>)}</span>
          </p>
        </article>
      );
    })}
  </div>
  {entries.length > 1 && <div class="controls">
    <button type="button" class="nav" data-prev aria-label="Previous project">←</button>
    <span class="dots">{entries.map((e, i) => <button type="button" class="dot" data-dot={i} aria-label={`Show ${e.title}`} />)}</span>
    <button type="button" class="nav" data-next aria-label="Next project">→</button>
  </div>}
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>("[data-carousel]")) {
    const track = root.querySelector<HTMLElement>("[data-track]")!;
    const slides = Array.from(track.children) as HTMLElement[];
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-dot]"));
    const n = slides.length;
    if (n < 2) continue;
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const every = Number(root.dataset.interval) || 7000;
    let i = 0, hold = false, timer = 0;

    const mark = () => dots.forEach((d, k) => d.setAttribute("aria-current", String(k === i)));
    const go = (k: number) => {
      i = (k + n) % n;
      track.scrollTo({ left: i * track.clientWidth, behavior: reduce ? "auto" : "smooth" });
      mark();
    };
    const start = () => {
      window.clearInterval(timer);
      if (!reduce) timer = window.setInterval(() => { if (!hold && !document.hidden) go(i + 1); }, every);
    };

    // Sync with swipes once scrolling settles; mid-scroll positions would undo a click.
    let settle = 0;
    track.addEventListener("scroll", () => {
      window.clearTimeout(settle);
      settle = window.setTimeout(() => {
        const k = Math.round(track.scrollLeft / track.clientWidth);
        if (k >= 0 && k < n && k !== i) { i = k; mark(); }
      }, 150);
    }, { passive: true });
    root.querySelector("[data-prev]")?.addEventListener("click", () => { go(i - 1); start(); });
    root.querySelector("[data-next]")?.addEventListener("click", () => { go(i + 1); start(); });
    dots.forEach((d, k) => d.addEventListener("click", () => { go(k); start(); }));
    root.addEventListener("mouseenter", () => (hold = true));
    root.addEventListener("mouseleave", () => (hold = false));
    root.addEventListener("focusin", () => (hold = true));
    root.addEventListener("focusout", () => (hold = false));
    window.addEventListener("resize", () => track.scrollTo({ left: i * track.clientWidth }));
    mark();
    start();
  }
</script>

<style>
  .carousel { border-top:1px solid var(--color-border); border-bottom:1px solid var(--color-border); }
  .track { display:flex; overflow-x:auto; scroll-snap-type:x mandatory; scrollbar-width:none; overscroll-behavior-x:contain; }
  .track::-webkit-scrollbar { display:none; }
  .slide { flex:0 0 100%; min-width:0; scroll-snap-align:start; padding:1.1rem 0 0.2rem; }
  .poster { display:block; border:1px solid var(--color-border-strong); line-height:0; background:#fff; }
  .poster img { display:block; width:100%; height:auto; transition:opacity .15s; }
  .poster:hover img { opacity:.9; }
  .line { margin:0.6rem 0 0; font-size:0.86rem; line-height:1.5; color:var(--color-text-muted); text-wrap:pretty; }
  .links { margin-left:0.5rem; font:0.72rem/1.5 var(--font-mono); white-space:nowrap; }
  .links a { color:var(--color-accent); text-decoration:none; }
  .links a:hover { text-decoration:underline; text-underline-offset:0.2em; }
  .sep { color:var(--color-text-ghost); margin:0 0.4rem; }

  .controls { display:flex; align-items:center; justify-content:center; gap:1rem; padding:0.4rem 0 0.7rem; }
  .nav { border:0; background:none; padding:0.2rem 0.5rem; font:0.9rem/1 var(--font-mono); color:var(--color-accent); cursor:pointer; }
  .nav:hover { color:var(--color-text); }
  .dots { display:flex; gap:0.55rem; }
  .dot { width:0.5rem; height:0.5rem; padding:0; border-radius:50%; border:1px solid var(--color-accent); background:transparent; cursor:pointer; }
  .dot[aria-current="true"] { background:var(--color-accent); }
  button:focus-visible, a:focus-visible { outline:2px solid var(--color-accent); outline-offset:3px; }
</style>
