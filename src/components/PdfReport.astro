---
// A project page whose content is the full report (XC, 28 Sep 2026: "每一个项目点开都是
// 完整的报告/pdf预览"). Desktop: the PDF inline in the browser's viewer. Narrow screens,
// where inline PDFs are unreliable: a first-page preview that opens the PDF.
interface Props {
  status: string;
  title: string;
  meta: string;            // one line: authorship / venue / date
  pdf: string;             // /papers/x.pdf
  preview: string;         // /papers/x.png (first page)
  back?: { label: string; href: string };
  links?: { label: string; href: string }[];
  note?: string;           // optional one-sentence note under the viewer
}
const { status, title, meta, pdf, preview, back = { label: "Research & Projects", href: "/research" }, links = [], note } = Astro.props;
---
<article class="pdfr">
  <p class="pdfr-back"><a href={back.href}>← {back.label}</a></p>
  <p class="pdfr-status">{status}</p>
  <h1>{title}</h1>
  <p class="pdfr-meta">{meta}</p>
  <p class="pdfr-actions">
    <a href={pdf} target="_blank" rel="noopener">Open PDF ↗</a>
    <a href={pdf} download>Download</a>
    {links.map((l) => <a href={l.href} rel="noopener">{l.label}</a>)}
  </p>
  <div class="pdfr-frame">
    <iframe src={`${pdf}#view=FitH`} title={`${title} (PDF)`} loading="lazy"></iframe>
  </div>
  <a class="pdfr-preview" href={pdf} target="_blank" rel="noopener">
    <img src={preview} alt={`First page of ${title}`} width="1000" height="1414" loading="lazy" />
    <span>Open the full PDF ↗</span>
  </a>
  {note && <p class="pdfr-note">{note}</p>}
</article>

<style>
  .pdfr-back { margin:0 0 1.4rem; font-size:0.86rem; }
  .pdfr-back a, .pdfr-actions a { color:var(--color-accent); text-decoration:none; }
  .pdfr-back a:hover, .pdfr-actions a:hover { text-decoration:underline; text-underline-offset:0.2em; }
  .pdfr-status { margin:0 0 0.5rem; font:0.68rem/1.5 var(--font-mono); letter-spacing:0.06em; text-transform:uppercase; color:var(--color-text-muted); }
  h1 { margin:0 0 0.5rem; font-size:clamp(1.6rem,4vw,2.1rem); font-weight:600; line-height:1.2; letter-spacing:-0.01em; text-wrap:balance; }
  .pdfr-meta { margin:0 0 1rem; color:var(--color-text-muted); font-size:0.95rem; line-height:1.55; }
  .pdfr-actions { display:flex; flex-wrap:wrap; gap:0.4rem 1.4rem; margin:0 0 1.2rem; font:0.8rem/1.6 var(--font-mono); }
  .pdfr-frame { border:1px solid var(--color-border-strong); background:var(--color-surface); }
  .pdfr-frame iframe { display:block; width:100%; height:min(88vh, 1100px); border:0; }
  .pdfr-preview { display:none; text-decoration:none; color:var(--color-accent); }
  .pdfr-preview img { display:block; width:100%; height:auto; border:1px solid var(--color-border-strong); }
  .pdfr-preview span { display:block; margin-top:0.6rem; font:0.8rem/1.6 var(--font-mono); }
  .pdfr-note { margin:0.9rem 0 0; font-size:0.86rem; line-height:1.55; color:var(--color-text-muted); }
  @media (max-width:700px) {
    .pdfr-frame { display:none; }
    .pdfr-preview { display:block; }
  }
</style>
